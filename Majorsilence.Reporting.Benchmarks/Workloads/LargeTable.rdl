<?xml version="1.0" encoding="UTF-8"?>
<Report Name="LargeTable">
  <Description>Benchmark workload: one table over a caller-supplied DataTable (SetData). Rows are generated by the benchmark.</Description>
  <DataSources>
    <DataSource Name="DS1">
      <ConnectionProperties>
        <DataProvider>Microsoft.Data.Sqlite</DataProvider>
        <ConnectString>Data Source=:memory:</ConnectString>
        <IntegratedSecurity>false</IntegratedSecurity>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Data">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>select 1 as Id, 'x' as Name, 1.5 as Amount, 'x' as Region</CommandText>
      </Query>
      <Fields>
        <Field Name="Id"><DataField>Id</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field>
        <Field Name="Name"><DataField>Name</DataField></Field>
        <Field Name="Amount"><DataField>Amount</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Double</rd:TypeName></Field>
        <Field Name="Region"><DataField>Region</DataField></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <Body>
    <Height>0.6in</Height>
    <ReportItems>
      <Table Name="Table1">
        <DataSetName>Data</DataSetName>
        <Top>0in</Top>
        <Left>0in</Left>
        <Width>7in</Width>
        <Height>0.6in</Height>
        <TableColumns>
          <TableColumn><Width>1in</Width></TableColumn>
          <TableColumn><Width>3in</Width></TableColumn>
          <TableColumn><Width>1.5in</Width></TableColumn>
          <TableColumn><Width>1.5in</Width></TableColumn>
        </TableColumns>
        <Header>
          <TableRows>
            <TableRow>
              <Height>0.2in</Height>
              <TableCells>
                <TableCell><ReportItems><Textbox Name="hId"><Value>Id</Value><Style><FontWeight>Bold</FontWeight></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="hName"><Value>Name</Value><Style><FontWeight>Bold</FontWeight></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="hAmount"><Value>Amount</Value><Style><FontWeight>Bold</FontWeight></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="hRegion"><Value>Region</Value><Style><FontWeight>Bold</FontWeight></Style></Textbox></ReportItems></TableCell>
              </TableCells>
            </TableRow>
          </TableRows>
          <RepeatOnNewPage>true</RepeatOnNewPage>
        </Header>
        <Details>
          <TableRows>
            <TableRow>
              <Height>0.2in</Height>
              <TableCells>
                <TableCell><ReportItems><Textbox Name="dId"><Value>=Fields!Id.Value</Value></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="dName"><Value>=Fields!Name.Value</Value></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="dAmount"><Value>=Fields!Amount.Value</Value><Style><Format>#,##0.00</Format><TextAlign>Right</TextAlign></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="dRegion"><Value>=Fields!Region.Value</Value></Textbox></ReportItems></TableCell>
              </TableCells>
            </TableRow>
          </TableRows>
        </Details>
        <Footer>
          <TableRows>
            <TableRow>
              <Height>0.2in</Height>
              <TableCells>
                <TableCell><ReportItems><Textbox Name="fLabel"><Value>Total</Value></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="fCount"><Value>=Count(Fields!Id.Value)</Value></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="fSum"><Value>=Sum(Fields!Amount.Value)</Value><Style><Format>#,##0.00</Format><TextAlign>Right</TextAlign></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="fBlank"><Value></Value></Textbox></ReportItems></TableCell>
              </TableCells>
            </TableRow>
          </TableRows>
        </Footer>
      </Table>
    </ReportItems>
  </Body>
  <PageFooter>
    <Height>0.25in</Height>
    <ReportItems>
      <Textbox Name="PageNo">
        <Top>0in</Top><Left>0in</Left><Height>0.2in</Height><Width>3in</Width>
        <Value>="Page " &amp; Globals!PageNumber</Value>
        <Style><FontSize>9pt</FontSize></Style>
      </Textbox>
    </ReportItems>
  </PageFooter>
  <Width>7in</Width>
  <PageWidth>8.5in</PageWidth>
  <PageHeight>11in</PageHeight>
  <TopMargin>0.5in</TopMargin>
  <BottomMargin>0.5in</BottomMargin>
  <LeftMargin>0.5in</LeftMargin>
  <RightMargin>0.5in</RightMargin>
</Report>
