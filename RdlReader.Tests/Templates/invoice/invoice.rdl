<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Invoice -- a single JSON document with company/customer header fields and a nested Lines array.</Description>
  <PageHeight>11in</PageHeight>
  <PageWidth>8.5in</PageWidth>
  <TopMargin>.5in</TopMargin>
  <LeftMargin>.6in</LeftMargin>
  <RightMargin>.6in</RightMargin>
  <BottomMargin>.5in</BottomMargin>
  <Width>7.3in</Width>

  <DataSources>
    <DataSource Name="DS1">
      <ConnectionProperties>
        <DataProvider>Json</DataProvider>
        <!-- Path is overridden at runtime; see the template's README. -->
        <ConnectString>file=sample-data.json</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="Header">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>columns=InvoiceNumber,InvoiceDate,DueDate,CompanyName,CompanyAddress,CustomerName,CustomerAddress,TaxRatePercent,Notes;table=root</CommandText>
      </Query>
      <Fields>
        <Field Name="InvoiceNumber"><DataField>InvoiceNumber</DataField><rd:TypeName>System.Text.Json.JsonElement</rd:TypeName></Field>
        <Field Name="InvoiceDate"><DataField>InvoiceDate</DataField><rd:TypeName>System.Text.Json.JsonElement</rd:TypeName></Field>
        <Field Name="DueDate"><DataField>DueDate</DataField><rd:TypeName>System.Text.Json.JsonElement</rd:TypeName></Field>
        <Field Name="CompanyName"><DataField>CompanyName</DataField><rd:TypeName>System.Text.Json.JsonElement</rd:TypeName></Field>
        <Field Name="CompanyAddress"><DataField>CompanyAddress</DataField><rd:TypeName>System.Text.Json.JsonElement</rd:TypeName></Field>
        <Field Name="CustomerName"><DataField>CustomerName</DataField><rd:TypeName>System.Text.Json.JsonElement</rd:TypeName></Field>
        <Field Name="CustomerAddress"><DataField>CustomerAddress</DataField><rd:TypeName>System.Text.Json.JsonElement</rd:TypeName></Field>
        <Field Name="TaxRatePercent"><DataField>TaxRatePercent</DataField><rd:TypeName>System.Text.Json.JsonElement</rd:TypeName></Field>
        <Field Name="Notes"><DataField>Notes</DataField><rd:TypeName>System.Text.Json.JsonElement</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="Lines">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>columns=Description,Quantity,UnitPrice;table=root_Lines</CommandText>
      </Query>
      <Fields>
        <Field Name="Description"><DataField>Description</DataField><rd:TypeName>System.Text.Json.JsonElement</rd:TypeName></Field>
        <Field Name="Quantity"><DataField>Quantity</DataField><rd:TypeName>System.Text.Json.JsonElement</rd:TypeName></Field>
        <Field Name="UnitPrice"><DataField>UnitPrice</DataField><rd:TypeName>System.Text.Json.JsonElement</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>

  <Body>
    <Height>9in</Height>
    <ReportItems>
      <Textbox Name="CompanyName">
        <Top>0in</Top><Left>0in</Left><Width>4in</Width><Height>.28in</Height>
        <Value>=First(Fields!CompanyName.Value, "Header")</Value>
        <Style><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><Color>#2C3E50</Color></Style>
      </Textbox>
      <Textbox Name="CompanyAddress">
        <Top>.32in</Top><Left>0in</Left><Width>4in</Width><Height>.4in</Height>
        <CanGrow>true</CanGrow>
        <Value>=First(Fields!CompanyAddress.Value, "Header")</Value>
        <Style><FontSize>9pt</FontSize><Color>Gray</Color></Style>
      </Textbox>

      <Textbox Name="InvoiceTitle">
        <Top>0in</Top><Left>4.8in</Left><Width>2.5in</Width><Height>.3in</Height>
        <Value>INVOICE</Value>
        <Style><FontSize>20pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign><Color>#7030A0</Color></Style>
      </Textbox>
      <Textbox Name="InvoiceNumberLabel">
        <Top>.34in</Top><Left>4.8in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>Invoice #</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign><Color>Gray</Color></Style>
      </Textbox>
      <Textbox Name="InvoiceNumberValue">
        <Top>.34in</Top><Left>6.1in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>=First(Fields!InvoiceNumber.Value, "Header")</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign></Style>
      </Textbox>
      <Textbox Name="InvoiceDateLabel">
        <Top>.53in</Top><Left>4.8in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>Invoice date</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign><Color>Gray</Color></Style>
      </Textbox>
      <Textbox Name="InvoiceDateValue">
        <Top>.53in</Top><Left>6.1in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>=First(Fields!InvoiceDate.Value, "Header")</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign></Style>
      </Textbox>
      <Textbox Name="DueDateLabel">
        <Top>.72in</Top><Left>4.8in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>Due date</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign><Color>Gray</Color></Style>
      </Textbox>
      <Textbox Name="DueDateValue">
        <Top>.72in</Top><Left>6.1in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>=First(Fields!DueDate.Value, "Header")</Value>
        <Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign></Style>
      </Textbox>

      <Textbox Name="BillToLabel">
        <Top>1.15in</Top><Left>0in</Left><Width>3in</Width><Height>.18in</Height>
        <Value>Bill To</Value>
        <Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>Gray</Color></Style>
      </Textbox>
      <Textbox Name="CustomerName">
        <Top>1.35in</Top><Left>0in</Left><Width>3.5in</Width><Height>.2in</Height>
        <Value>=First(Fields!CustomerName.Value, "Header")</Value>
        <Style><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight></Style>
      </Textbox>
      <Textbox Name="CustomerAddress">
        <Top>1.57in</Top><Left>0in</Left><Width>3.5in</Width><Height>.4in</Height>
        <CanGrow>true</CanGrow>
        <Value>=First(Fields!CustomerAddress.Value, "Header")</Value>
        <Style><FontSize>9pt</FontSize></Style>
      </Textbox>

      <Table Name="LinesTable">
        <DataSetName>Lines</DataSetName>
        <NoRows>No line items.</NoRows>
        <Top>2.3in</Top>
        <Left>0in</Left>
        <TableColumns>
          <TableColumn><Width>3.7in</Width></TableColumn>
          <TableColumn><Width>1in</Width></TableColumn>
          <TableColumn><Width>1.3in</Width></TableColumn>
          <TableColumn><Width>1.3in</Width></TableColumn>
        </TableColumns>
        <Header>
          <TableRows>
            <TableRow>
              <Height>.22in</Height>
              <TableCells>
                <TableCell><ReportItems><Textbox Name="H_Desc"><Value>Description</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2C3E50</BackgroundColor><Color>White</Color><PaddingLeft>4pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="H_Qty"><Value>Qty</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2C3E50</BackgroundColor><Color>White</Color><TextAlign>Right</TextAlign><PaddingRight>4pt</PaddingRight><VerticalAlign>Middle</VerticalAlign></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="H_Price"><Value>Unit Price</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2C3E50</BackgroundColor><Color>White</Color><TextAlign>Right</TextAlign><PaddingRight>4pt</PaddingRight><VerticalAlign>Middle</VerticalAlign></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="H_Total"><Value>Amount</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2C3E50</BackgroundColor><Color>White</Color><TextAlign>Right</TextAlign><PaddingRight>4pt</PaddingRight><VerticalAlign>Middle</VerticalAlign></Style></Textbox></ReportItems></TableCell>
              </TableCells>
            </TableRow>
          </TableRows>
          <RepeatOnNewPage>true</RepeatOnNewPage>
        </Header>
        <Details>
          <TableRows>
            <TableRow>
              <Height>.2in</Height>
              <TableCells>
                <TableCell><ReportItems><Textbox Name="D_Desc"><Value>=Fields!Description.Value</Value><CanGrow>true</CanGrow><Style><PaddingLeft>4pt</PaddingLeft><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#F3EEFA", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="D_Qty"><Value>=Fields!Quantity.Value</Value><Style><TextAlign>Right</TextAlign><PaddingRight>4pt</PaddingRight><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#F3EEFA", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="D_Price"><Value>=Format(Fields!UnitPrice.Value, "C2")</Value><Style><TextAlign>Right</TextAlign><PaddingRight>4pt</PaddingRight><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#F3EEFA", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="D_Total"><Value>=Format(Fields!Quantity.Value * Fields!UnitPrice.Value, "C2")</Value><Style><TextAlign>Right</TextAlign><PaddingRight>4pt</PaddingRight><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#F3EEFA", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell>
              </TableCells>
            </TableRow>
          </TableRows>
        </Details>
      </Table>

      <Textbox Name="SubtotalLabel">
        <Top>4.6in</Top><Left>4.9in</Left><Width>1.2in</Width><Height>.2in</Height>
        <Value>Subtotal</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign><Color>Gray</Color></Style>
      </Textbox>
      <Textbox Name="SubtotalValue">
        <Top>4.6in</Top><Left>6.1in</Left><Width>1.2in</Width><Height>.2in</Height>
        <Value>=Format(Sum(Fields!Quantity.Value * Fields!UnitPrice.Value, "Lines"), "C2")</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign></Style>
      </Textbox>
      <Textbox Name="TaxLabel">
        <Top>4.82in</Top><Left>4.9in</Left><Width>1.2in</Width><Height>.2in</Height>
        <Value>=Format(First(Fields!TaxRatePercent.Value, "Header"), "0.##") &amp; "% Tax"</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign><Color>Gray</Color></Style>
      </Textbox>
      <Textbox Name="TaxValue">
        <Top>4.82in</Top><Left>6.1in</Left><Width>1.2in</Width><Height>.2in</Height>
        <Value>=Format(Sum(Fields!Quantity.Value * Fields!UnitPrice.Value, "Lines") * (First(Fields!TaxRatePercent.Value, "Header") / 100), "C2")</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign></Style>
      </Textbox>
      <Textbox Name="TotalLabel">
        <Top>5.08in</Top><Left>4.9in</Left><Width>1.2in</Width><Height>.24in</Height>
        <Value>Total Due</Value>
        <Style><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign></Style>
      </Textbox>
      <Textbox Name="TotalValue">
        <Top>5.08in</Top><Left>6.1in</Left><Width>1.2in</Width><Height>.24in</Height>
        <Value>=Format(Sum(Fields!Quantity.Value * Fields!UnitPrice.Value, "Lines") * (1 + First(Fields!TaxRatePercent.Value, "Header") / 100), "C2")</Value>
        <Style><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign><Color>#7030A0</Color></Style>
      </Textbox>

      <Textbox Name="NotesLabel">
        <Top>5.6in</Top><Left>0in</Left><Width>4in</Width><Height>.18in</Height>
        <Value>Notes</Value>
        <Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>Gray</Color></Style>
      </Textbox>
      <Textbox Name="NotesValue">
        <Top>5.8in</Top><Left>0in</Left><Width>5in</Width><Height>.6in</Height>
        <CanGrow>true</CanGrow>
        <Value>=First(Fields!Notes.Value, "Header")</Value>
        <Style><FontSize>9pt</FontSize></Style>
      </Textbox>
    </ReportItems>
  </Body>

  <PageFooter>
    <Height>16pt</Height>
    <PrintOnFirstPage>true</PrintOnFirstPage>
    <PrintOnLastPage>true</PrintOnLastPage>
    <ReportItems>
      <Textbox Name="PageNum">
        <Top>1pt</Top><Left>0in</Left><Width>3in</Width><Height>14pt</Height>
        <Value>=Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value>
        <Style><FontSize>8pt</FontSize><Color>Gray</Color></Style>
      </Textbox>
    </ReportItems>
  </PageFooter>
</Report>
