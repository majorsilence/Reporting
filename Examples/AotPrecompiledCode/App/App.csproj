<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <AssemblyName>AotPrecompiledCode</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../RdlEngine/Majorsilence.Reporting.RdlEngine.csproj" />
    <ProjectReference Include="../ReportCode/ReportCode.vbproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../RdlEngine/RdlEngineConfig.xml" Link="RdlEngineConfig.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../ScoreCard.rdl" Link="ScoreCard.rdl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../SqliteExamples/sqlitetestdb2.db" Link="sqlitetestdb2.db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
</Project>
