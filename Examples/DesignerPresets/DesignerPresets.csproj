  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\RdlDesign\Majorsilence.Reporting.ReportDesigner.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\RdlEngine\RdlEngineConfig.xml" Link="RdlEngineConfig.xml">
