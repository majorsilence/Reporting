<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net48/net8.0-windows dropped, real System.Windows.Forms reference (UseWindowsForms) dropped:
         this now builds against Majorsilence.Forms via Majorsilence.Forms.WinFormsShims.Compat, whose
         generated System.Windows.Forms-namespace compat surface lets this Designer.cs-generated
         source compile unchanged. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SampleApp2_SetData</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <None Update="SampleApp2-TestReport.rdl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
	  <Content Include="..\..\..\RdlEngine\RdlEngineConfig.xml" Link="RdlEngineConfig.xml">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\RdlViewer\RdlViewer.csproj" />
    <ProjectReference Include="..\..\..\RdlCri\Majorsilence.Reporting.RdlCri.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Majorsilence.Forms" />
    <PackageReference Include="Majorsilence.Forms.Avalonia" />
    <PackageReference Include="Majorsilence.Forms.WinFormsShims.Compat" />
  </ItemGroup>
</Project>
