<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- if not windows define DRAWINGCOMPAT to use Majorsilence.Forms.Drawing instead of System.Drawing -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <DefineConstants>DRAWINGCOMPAT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\RdlEngine\Majorsilence.Reporting.RdlEngine.csproj" />
    <ProjectReference Include="..\..\RdlCri\Majorsilence.Reporting.RdlCri.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same drivers RdlCmd references; RegisterDataProvider (AotDataProviders.cs) is how AOT finds them. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="MySql.Data" />
    <PackageReference Include="Npgsql" />
    <Compile Include="..\..\RdlCmd\AotDataProviders.cs" Link="AotDataProviders.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\RdlEngine\RdlEngineConfig.xml" Link="RdlEngineConfig.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
