<Project>
  <!-- Pulled into every hosting example: the shared viewer content, the sample report and its database. -->
  <PropertyGroup>
    <!-- Examples, not packages. The release packs the whole solution with no build, and packing
         HostingUno that way rebuilds its references (NETSDK1085), which failed the 27.0.0-alpha.2 release. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)ReportContent.cs" Link="ReportContent.cs" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\RdlViewer\RdlViewer.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\RdlCri\Majorsilence.Reporting.RdlCri.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Majorsilence.Forms" />
    <None Include="$(MSBuildThisFileDirectory)..\..\ExportSqliteToPdf\Products.rdl" Link="Products.rdl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\SqliteExamples\sqlitetestdb2.db" Link="sqlitetestdb2.db" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\..\RdlEngine\RdlEngineConfig.xml" Link="RdlEngineConfig.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
