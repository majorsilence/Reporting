<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Majorsilence.Reporting.RdlDoctor</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rdl-doctor</ToolCommandName>
    <PackageId>Majorsilence.Reporting.RdlDoctor</PackageId>
    <Description>Scans .rdl/.rdlc report definitions for constructs Majorsilence Reporting's RDL engine doesn't support (Tablix, Gauge/Indicator/Sparkline data regions, unsupported expression functions, and more) -- a compatibility-check tool for migrating from SSRS 2008+ or Crystal Reports.</Description>
    <PackageTags>rdl;rdlc;ssrs;migration;dotnet-tool</PackageTags>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RdlEngine\Majorsilence.Reporting.RdlEngine.csproj" />
  </ItemGroup>
</Project>
