<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <RootNamespace>Majorsilence.Reporting.Cri</RootNamespace>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <AssemblyTitle>RdlCri</AssemblyTitle>
        <Description>CustomReportItem library for Majorsilence Reporting — barcodes (EAN, Code 128, and more) and QR codes as native RDL report items via ZXing. Targets .NET 8, .NET 10, and .NET Framework 4.8. Use Majorsilence.Reporting.RdlCri.SkiaSharp on Linux, macOS, and containers.</Description>
        <PackageTags>rdl;rdlc;ssrs;reporting;barcode;qrcode;crystal-reports-alternative;cross-platform;dotnet</PackageTags>
        <DelaySign>false</DelaySign>
        <PackageId>Majorsilence.Reporting.RdlCri</PackageId>
        <Configurations>Debug;Release;Debug-DrawingCompat;Release-DrawingCompat</Configurations>
		<TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
        <TargetFrameworks Condition="'$(OS)' == 'Unix'">net8.0;net10.0</TargetFrameworks>
		<WarningsAsErrors>4014</WarningsAsErrors>
        <IsPackable>true</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    </PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Debug-DrawingCompat' Or '$(Configuration)' == 'Release-DrawingCompat'">
		<PackageId>Majorsilence.Reporting.RdlCri.SkiaSharp</PackageId>
		<Description>CustomReportItem library for Majorsilence Reporting — barcodes (EAN, Code 128, and more) and QR codes as native RDL report items via ZXing. SkiaSharp-based rendering for Linux, macOS, Windows, and containers. Targets .NET 8 and .NET 10.</Description>
	</PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\RdlEngine\Majorsilence.Reporting.RdlEngine.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="ZXing.Net" />
    </ItemGroup>
	<ItemGroup Condition="'$(DrawingCompat)' != 'true' And '$(OS)' == 'Windows_NT'">
		<PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" />
	</ItemGroup>
	<ItemGroup Condition="'$(DrawingCompat)' == 'true'">
		<PackageReference Include="ZXing.Net.Bindings.SkiaSharp" />
	</ItemGroup>
		
    <ItemGroup>
        <Folder Include="Properties\" />
    </ItemGroup>
</Project>
