<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<RootNamespace>RdlGtk3Viewer</RootNamespace>
		<AssemblyName>RdlGtk3Viewer</AssemblyName>
		<Configurations>Debug;Release</Configurations>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<!-- CI (and any Windows build) only needs the managed GtkSharp assemblies; skip the
		     54 MB native-GTK download, whose two multi-TFM inner builds race for the same cache file. -->
		<SkipGtkInstall>True</SkipGtkInstall>
		<WarningsAsErrors>4014</WarningsAsErrors>
        <IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\RdlGtk3\Majorsilence.Reporting.RdlGtk3.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="GtkSharp" />
		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="Microsoft.Data.Sqlite" />
		<PackageReference Include="MySql.Data" />
		<PackageReference Include="Npgsql" />
	</ItemGroup>

</Project>
