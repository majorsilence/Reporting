<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<AssemblyTitle>RDL Data WPF Library</AssemblyTitle>
		<DelaySign>false</DelaySign>
		<PackageId>Majorsilence.Reporting.LibRdlWpfViewer</PackageId>
		<Description>[MAINTENANCE MODE — new development should use the Avalonia viewer (Majorsilence.Reporting.UI.RdlAvalonia) or the web viewer.] WPF wrapper around the Majorsilence.Forms-based report viewer for Majorsilence Reporting (Windows only), hosted via Majorsilence.Forms.WinForms's ToWinFormsControl(). Targets .NET 8 (Windows) and .NET 10 (Windows).</Description>
		<Configurations>Debug;Release</Configurations>
		<!-- net48 dropped: RdlViewer is now Majorsilence.Forms-based (net8.0/net10.0 only). -->
		<TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
		<WarningsAsErrors>4014</WarningsAsErrors>
        <IsPackable>true</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<Reference Update="System.Core">
			<RequiredTargetFramework>3.5</RequiredTargetFramework>
		</Reference>
		<Reference Update="System.Xml.Linq">
			<RequiredTargetFramework>3.5</RequiredTargetFramework>
		</Reference>
		<Reference Update="UIAutomationProvider">
			<RequiredTargetFramework>3.0</RequiredTargetFramework>
		</Reference>
		<Reference Update="WindowsFormsIntegration">
			<RequiredTargetFramework>3.0</RequiredTargetFramework>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<AppDesigner Include="Properties\" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\DataProviders\Majorsilence.Reporting.DataProviders.csproj" />
		<ProjectReference Include="..\RdlCri\Majorsilence.Reporting.RdlCri.csproj" />
		<ProjectReference Include="..\RdlEngine\Majorsilence.Reporting.RdlEngine.csproj" />
		<ProjectReference Include="..\RdlViewer\RdlViewer.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="System.Data.DataSetExtensions" />
		<PackageReference Include="Majorsilence.Forms.WinForms" />
	</ItemGroup>
</Project>
