<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<AssemblyName>RdlCreator</AssemblyName>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageId>Majorsilence.Reporting.RdlCreator</PackageId>
		<Description>Code-first fluent API for Majorsilence Reporting — build RDL report definitions and PDF documents programmatically in C#, no designer required. SkiaSharp-based rendering for Linux, macOS, Windows, and containers. Targets .NET 8 and .NET 10.</Description>
		<Configurations>Debug;Release</Configurations>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<WarningsAsErrors>4014</WarningsAsErrors>
        <IsPackable>true</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\DataProviders\Majorsilence.Reporting.DataProviders.csproj" />
		<ProjectReference Include="..\Majorsilence.Pdf\Majorsilence.Pdf.csproj" />
		<ProjectReference Include="..\RdlCri\Majorsilence.Reporting.RdlCri.csproj" />
		<ProjectReference Include="..\RdlEngine\Majorsilence.Reporting.RdlEngine.csproj" />
	</ItemGroup>

</Project>
