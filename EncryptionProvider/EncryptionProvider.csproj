<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<AssemblyTitle>EncryptionProvider</AssemblyTitle>
		<PackageId>Majorsilence.Reporting.EncryptionProvider</PackageId>
		<Description>Connection-string encryption helper for Majorsilence Reporting viewers and designers. Targets .NET 8 and .NET 10, any OS Majorsilence.Forms supports.</Description>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<WarningsAsErrors>4014</WarningsAsErrors>
        <IsPackable>true</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Majorsilence.Forms" />
		<PackageReference Include="System.Data.DataSetExtensions" />
	</ItemGroup>
</Project>
