<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mspdf-preview</ToolCommandName>
    <PackageId>Majorsilence.Pdf.Previewer</PackageId>
    <Description>Live PDF preview while you code. Watches a PDF file (or runs your project under `dotnet watch` and watches its output) and auto-reloads a browser tab on every rebuild. A dev-time companion tool for Majorsilence.Pdf — not a runtime dependency.</Description>
    <PackageTags>pdf;dotnet-tool;dev-tools;hot-reload</PackageTags>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>MIT OR Apache-2.0 OR BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Majorsilence.Pdf.Previewer.Tests" />
  </ItemGroup>
</Project>
