<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Local feed for Majorsilence.Forms packages built from ../Majorsilence.Forms source (that repo
      was renamed from Modern.Forms; MIGRATION-NOTES.md's older sections still say
      "../Modern.Forms", but the actual path is ../Majorsilence.Forms), for API additions that
      haven't been published to nuget.org yet: see MIGRATION-NOTES.md's "Modern.Forms source vs.
      published package" section. Rebuild with:
        dotnet pack ../Majorsilence.Forms/src/Majorsilence.Forms/Majorsilence.Forms.csproj -c Release -o .local-nuget-feed
        dotnet pack ../Majorsilence.Forms/src/Majorsilence.Forms.Avalonia/Majorsilence.Forms.Avalonia.csproj -c Release -o .local-nuget-feed
        dotnet pack ../Majorsilence.Forms/src/Majorsilence.Forms.Headless/Majorsilence.Forms.Headless.csproj -c Release -o .local-nuget-feed
      Majorsilence.Forms.WinForms only compiles/packs on Windows (its csproj conditions
      TargetFrameworks/PackageId on $(OS)=='Windows_NT'), so this one must be run from Windows:
        dotnet pack ../Majorsilence.Forms/src/Majorsilence.Forms.WinForms/Majorsilence.Forms.WinForms.csproj -c Release -o .local-nuget-feed
    -->
    <add key="majorsilence-forms-local" value=".local-nuget-feed" />
  </packageSources>
</configuration>
