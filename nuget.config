<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Local feed for Majorsilence.Forms packages built from ../Modern.Forms source.
      Used while Track D (WinForms to Majorsilence.Forms migration) needs API additions that
      have not been published to nuget.org yet: see MIGRATION-NOTES.md, "Modern.Forms source
      vs published package" section. Rebuild with:
        dotnet pack ../Modern.Forms/src/Majorsilence.Forms/Majorsilence.Forms.csproj -c Release -o .local-nuget-feed
        dotnet pack ../Modern.Forms/src/Majorsilence.Forms.Avalonia/Majorsilence.Forms.Avalonia.csproj -c Release -o .local-nuget-feed
        dotnet pack ../Modern.Forms/src/Majorsilence.Forms.Headless/Majorsilence.Forms.Headless.csproj -c Release -o .local-nuget-feed
    -->
    <add key="majorsilence-forms-local" value=".local-nuget-feed" />
  </packageSources>
</configuration>
