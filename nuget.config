<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Local feed for Majorsilence.Forms packages built from ../Majorsilence.Forms source, for API
      additions that haven't been published to nuget.org yet: see MIGRATION-NOTES.md's "Modern.Forms
      source vs. published package" section. Rebuild with:
        dotnet pack ../Majorsilence.Forms/src/Majorsilence.Forms/Majorsilence.Forms.csproj -c Release -o .local-nuget-feed
        dotnet pack ../Majorsilence.Forms/src/Majorsilence.Forms.Avalonia/Majorsilence.Forms.Avalonia.csproj -c Release -o .local-nuget-feed
        dotnet pack ../Majorsilence.Forms/src/Majorsilence.Forms.Headless/Majorsilence.Forms.Headless.csproj -c Release -o .local-nuget-feed
    -->
    <add key="majorsilence-forms-local" value=".local-nuget-feed" />
  </packageSources>
</configuration>
