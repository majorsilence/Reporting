<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compatibility alias for Majorsilence.Reporting.RdlEngine. The ".SkiaSharp"-suffixed ID used
    to be the cross-platform SkiaSharp render path; the base ID is that build now (see
    ../README.md). This package ships no assemblies — just a same-version dependency on
    Majorsilence.Reporting.RdlEngine so existing package references keep resolving.
  -->
  <PropertyGroup>
    <PackageId>Majorsilence.Reporting.RdlEngine.SkiaSharp</PackageId>
    <Description>Compatibility alias — depends on Majorsilence.Reporting.RdlEngine at the same version. Reporting renders through SkiaSharp (Majorsilence.Forms.Drawing) in every configuration now, so the base package is the former ".SkiaSharp" build. Reference Majorsilence.Reporting.RdlEngine directly in new code.</Description>
    <PackageTags>rdl;rdlc;ssrs;reporting;skiasharp;metapackage;compatibility</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RdlEngine\Majorsilence.Reporting.RdlEngine.csproj" />
  </ItemGroup>

</Project>
