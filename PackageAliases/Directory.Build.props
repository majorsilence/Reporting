<Project>

  <!-- The SDK imports only the nearest Directory.Build.props, so pull in the repo-wide one
       (Version, license, package metadata) explicitly, then layer the metapackage settings. -->
  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <!-- Metapackage: carries a dependency, no assemblies of its own. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- NU5128: no lib/ref assets — expected for a metapackage. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

</Project>
