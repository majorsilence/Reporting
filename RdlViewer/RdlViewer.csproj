<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectType>Local</ProjectType>
    <OutputType>Library</OutputType>
    <RootNamespace>Majorsilence.Reporting.RdlViewer</RootNamespace>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
    <PublishUrl>publish\</PublishUrl>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <AssemblyTitle>RDL Viewer (Majorsilence.Forms)</AssemblyTitle>
    <DelaySign>false</DelaySign>
    <PackageId>Majorsilence.Reporting.RdlViewer</PackageId>
    <Description>Cross-platform report viewer control for Majorsilence Reporting, built on Majorsilence.Forms. Embed RDL/RDLC report viewing, printing (PDF only -- see MIGRATION-NOTES.md), and export in desktop apps. Targets .NET 8 and .NET 10, any OS Majorsilence.Forms.Avalonia supports. For System.Windows.Forms hosts, embed via Majorsilence.Forms.WinForms's ToWinFormsControl().</Description>
    <!-- Declared explicitly (not just relying on MSBuild's implicit Debug;Release default) so it
         matches the rest of the solution's 4-config set; an inconsistent/missing Configurations
         list across referenced projects is what caused a real "ref assembly could not be found"
         build failure for a project referencing this one under Debug-DrawingCompat/
         Release-DrawingCompat in Visual Studio. -->
    <Configurations>Debug;Release</Configurations>
    <!-- net48 dropped: Majorsilence.Forms itself only targets net8.0/net10.0. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <WarningsAsErrors>4014</WarningsAsErrors>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="PageDrawing.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="RdlViewer.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="RdlViewerFind.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="ViewerToolstrip.cs">
      <SubType>Component</SubType>
    </Compile>
    <EmbeddedResource Include="Resources\document-print.png" />
    <EmbeddedResource Include="Resources\document-open.png" />
    <EmbeddedResource Include="Resources\document-save.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EncryptionProvider\EncryptionProvider.csproj" />
    <ProjectReference Include="..\Majorsilence.WinformUtils\Majorsilence.WinformUtils.csproj" />
    <ProjectReference Include="..\RdlEngine\Majorsilence.Reporting.RdlEngine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.Resources.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Majorsilence.Forms" />
    <PackageReference Include="Majorsilence.Forms.Avalonia" />
  </ItemGroup>
</Project>
