<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<ApplicationIcon>App.ico</ApplicationIcon>
		<DelaySign>false</DelaySign>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<RootNamespace>Majorsilence.Reporting.RdlCmd</RootNamespace>
		<RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
		<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
		<Configurations>Debug;Release</Configurations>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<WarningsAsErrors>4014</WarningsAsErrors>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<!-- AOT and trim-analysis for .NET 8+ -->
	<PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
		<IsAotCompatible>true</IsAotCompatible>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	</PropertyGroup>
	<!-- Use the SkiaSharp-based drawing compat layer on non-Windows -->
	<PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
		<DefineConstants>DRAWINGCOMPAT</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<Reference Update="System">
			<Name>System</Name>
		</Reference>
		<Reference Update="System.Data">
			<Name>System.Data</Name>
		</Reference>
		<Reference Update="System.Xml">
			<Name>System.XML</Name>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<Content Include="App.ico" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Microsoft.Data.SqlClient" />
	  <PackageReference Include="Microsoft.Data.Sqlite" />
	  <PackageReference Include="MySql.Data" />
	  <PackageReference Include="Npgsql" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\DataProviders\Majorsilence.Reporting.DataProviders.csproj" />
		<ProjectReference Include="..\RdlCri\Majorsilence.Reporting.RdlCri.csproj" />
		<ProjectReference Include="..\RdlEngine\Majorsilence.Reporting.RdlEngine.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- Required for System.Drawing on Linux when DRAWINGCOMPAT is not active; must be in the
		     project file (not runtimeconfig.template.json) to work correctly under PublishAot. -->
		<RuntimeHostConfigurationOption Include="System.Drawing.EnableUnixSupport"
		                                Value="true"
		                                Trim="true" />
	</ItemGroup>
	<PropertyGroup />
</Project>
