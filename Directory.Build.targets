<Project>
  <!--
    Strip net48 from TargetFrameworks during AOT publish so the SDK never spawns a .NETFramework
    inner build. PublishAot=true propagates to all project references; .NETFramework triggers
    NETSDK1207. This PropertyGroup fires after each project file sets TargetFrameworks, so the
    override takes effect before the SDK's multi-target dispatch targets run.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true' AND $(TargetFrameworks.Contains('net48'))">
    <TargetFrameworks>$([System.String]::Copy('$(TargetFrameworks)').Replace('net48;', '').Replace(';net48', '').Replace('net48', ''))</TargetFrameworks>
  </PropertyGroup>

  <!--
    For project references that resolve to a non-.NETCoreApp TFM (e.g. netstandard2.0 in
    Majorsilence.Pdf), disable AOT before ProcessFrameworkReferences passes PublishAot to the
    SDK task. When PublishAot=true, the SDK sets _RequiresILLinkPack=true, causing
    ProcessFrameworkReferences to run even for netstandard2.0 projects; the task then throws
    NETSDK1207 because it receives PublishAot=true and a non-.NETCoreApp TargetFrameworkIdentifier.
    A target-level PropertyGroup overrides the global CLI property for all subsequent tasks and
    targets in the same build session, so setting PublishAot=false here prevents the error.
    The top-level .NETCoreApp project's ILC pass handles all referenced IL; referenced libraries
    do not need their own AOT compilation pass.
  -->
  <!--
    Suppress AOT/trim for any inner build whose TFM does not support Native AOT (requires ≥ net7.0).
    IsTargetFrameworkCompatible(tfm, 'net7.0') returns false for netstandard2.0, net6.0, net48, etc.
    The condition gates on '$(TargetFramework)' != '' so it only fires in inner builds, not the outer
    multi-target dispatch where TargetFramework is still empty.
  -->
  <!--
    Give every packable project a NuGet readme. If the project's own directory has a Readme.md,
    pack that one (e.g. Majorsilence.Pdf/Readme.md); otherwise fall back to the repo root Readme.md.
    Projects that set PackageReadmeFile explicitly in their csproj are left alone. Lives in .targets
    (not .props) so the empty-check sees project-set values.
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true' AND '$(PackageReadmeFile)' == '' AND Exists('$(MSBuildProjectDirectory)/Readme.md')">
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <_PackProjectReadme>true</_PackProjectReadme>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsPackable)' == 'true' AND '$(PackageReadmeFile)' == '' AND '$(_PackProjectReadme)' != 'true'">
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <_PackRootReadme>true</_PackRootReadme>
  </PropertyGroup>
  <ItemGroup Condition="'$(_PackProjectReadme)' == 'true'">
    <None Include="$(MSBuildProjectDirectory)/Readme.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(_PackRootReadme)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)Readme.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    Runtime Async (.NET 11): compile async methods to runtime-native async instead of
    compiler-generated state machines, for net11.0+ inner builds only. Older TFMs (net8.0/net10.0,
    netstandard2.0) keep the state-machine codegen because their runtimes cannot execute it.
    net11.0 no longer needs EnablePreviewFeatures for this. Lives in .targets (not .props) so
    single-TFM projects, which set TargetFramework in the project body, also see it. Opt a project
    out with <EnableRuntimeAsync>false</EnableRuntimeAsync>.
  -->
  <PropertyGroup Condition="'$(EnableRuntimeAsync)' != 'false' AND '$(TargetFramework)' != '' AND
                            '$(TargetFrameworkIdentifier)' == '.NETCoreApp' AND
                            $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <Target Name="_DisableAotForNonAotCompatibleTfm" BeforeTargets="ProcessFrameworkReferences"
          Condition="'$(PublishAot)' == 'true' AND '$(TargetFramework)' != '' AND
                     !$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">
    <PropertyGroup>
      <PublishAot>false</PublishAot>
      <PublishTrimmed>false</PublishTrimmed>
      <_RequiresILLinkPack>false</_RequiresILLinkPack>
    </PropertyGroup>
  </Target>
</Project>
