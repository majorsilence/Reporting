<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
    <AssemblyTitle>Majorsilence Excel</AssemblyTitle>
    <PackageId>Majorsilence.Excel</PackageId>
    <Description>Zero-dependency .xlsx (OOXML SpreadsheetML) writer and reader. Writes typed cells, number formats, formulas, rich text, styles, merges, images, multiple sheets, freeze panes, filters, named ranges, hyperlinks, data validation, conditional formatting, comments, tables and sheet protection, with a streaming writer for large exports; reads cell values with Excel's displayed text. No Excel, Office interop or third-party package needed. Native AOT compatible. Targets .NET Standard 2.0, .NET 6, .NET 8, and .NET 10.</Description>
    <PackageTags>excel;xlsx;spreadsheet;ooxml;aot;zero-dependency;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>MIT OR Apache-2.0 OR BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
