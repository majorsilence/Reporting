      <Textbox Name="T13"><Top>0.17in</Top><Left>2.05in</Left><Width>1.85in</Width><Height>0.17in</Height><Value>Patient’s Office Account #</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign></Style></Textbox>
      <Textbox Name="T14"><Top>0.32in</Top><Left>2.05in</Left><Width>1.85in</Width><Height>0.17in</Height><Value>=First(Fields!PatientAccountNo.Value, "Claim")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><BorderStyle><Bottom>Solid</Bottom></BorderStyle><BorderWidth><Default>.5pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>2pt</PaddingLeft></Style></Textbox>
