      <Rectangle Name="ProcedureLinesBox"><Top>1.58in</Top><Left>0in</Left><Width>4.95in</Width><Height>2.0in</Height><ReportItems><Table Name="ProcedureLines"><DataSetName>Lines</DataSetName><Top>0.3in</Top><Left>0in</Left><TableColumns><TableColumn><Width>0.25in</Width></TableColumn><TableColumn><Width>0.25in</Width></TableColumn><TableColumn><Width>0.25in</Width></TableColumn><TableColumn><Width>0.62in</Width></TableColumn><TableColumn><Width>0.45in</Width></TableColumn><TableColumn><Width>1.03in</Width></TableColumn><TableColumn><Width>0.7in</Width></TableColumn><TableColumn><Width>0.7in</Width></TableColumn><TableColumn><Width>0.7in</Width></TableColumn></TableColumns><Details><TableRows><TableRow><Height>0.17in</Height><TableCells><TableCell><ReportItems><Textbox Name="L_Day"><Value>=IIf(Fields!ServiceDate.Value = "", "", Format(CDate(Fields!ServiceDate.Value), "dd"))</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Center</TextAlign><PaddingTop>1pt</PaddingTop><PaddingRight>3pt</PaddingRight></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="L_Mo"><Value>=IIf(Fields!ServiceDate.Value = "", "", Format(CDate(Fields!ServiceDate.Value), "MM"))</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Center</TextAlign><PaddingTop>1pt</PaddingTop><PaddingRight>3pt</PaddingRight></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="L_Yr"><Value>=IIf(Fields!ServiceDate.Value = "", "", Format(CDate(Fields!ServiceDate.Value), "yy"))</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Center</TextAlign><PaddingTop>1pt</PaddingTop><PaddingRight>3pt</PaddingRight></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="L_Proc"><Value>=Fields!ProcedureCode.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Center</TextAlign><PaddingTop>1pt</PaddingTop><PaddingRight>3pt</PaddingRight></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="L_Tooth"><Value>=Fields!ToothCode.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Center</TextAlign><PaddingTop>1pt</PaddingTop><PaddingRight>3pt</PaddingRight></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="L_Surf"><Value>=Fields!ToothSurfaces.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Center</TextAlign><PaddingTop>1pt</PaddingTop><PaddingRight>3pt</PaddingRight></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="L_Fee"><Value>=Format(Fields!DentistFee.Value, "0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Right</TextAlign><PaddingTop>1pt</PaddingTop><PaddingRight>3pt</PaddingRight></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="L_Lab"><Value>=Format(Fields!LabCharge.Value, "0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Right</TextAlign><PaddingTop>1pt</PaddingTop><PaddingRight>3pt</PaddingRight></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="L_Total"><Value>=Format(Fields!DentistFee.Value + Fields!LabCharge.Value, "0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Right</TextAlign><PaddingTop>1pt</PaddingTop><PaddingRight>3pt</PaddingRight></Style></Textbox></ReportItems></TableCell></TableCells></TableRow></TableRows></Details></Table></ReportItems></Rectangle>
      <Textbox Name="T62"><Top>3.61in</Top><Left>2.85in</Left><Width>1.4in</Width><Height>0.18in</Height><Value>TOTAL FEE SUBMITTED</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#555555</Default></BorderColor><BorderWidth><Default>.5pt</Default></BorderWidth><VerticalAlign>Middle</VerticalAlign></Style></Textbox>
      <Textbox Name="T63"><Top>3.61in</Top><Left>4.25in</Left><Width>0.7in</Width><Height>0.18in</Height><Value>=Format(Sum(Fields!DentistFee.Value + Fields!LabCharge.Value, "Lines"), "0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#555555</Default></BorderColor><BorderWidth><Default>.5pt</Default></BorderWidth><PaddingRight>3pt</PaddingRight></Style></Textbox>
      <Textbox Name="T64"><Top>3.66in</Top><Left>0in</Left><Width>2.55in</Width><Height>0.24in</Height><Value>This is an accurate statement of services performed and the total fee due and payable, errors and omissions excepted.</Value><Style><FontFamily>Arial</FontFamily><FontSize>5.5pt</FontSize></Style></Textbox>
      <Textbox Name="T65"><Top>3.7800000000000002in</Top><Left>2.45in</Left><Width>0.9in</Width><Height>0.17in</Height><Value>Dentist’s Signature</Value><Style><FontFamily>Arial</FontFamily><FontSize>6pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox>
