      <Textbox Name="T67"><Top>1.58in</Top><Left>5.05in</Left><Width>2.75in</Width><Height>0.25in</Height><Value>FOR DENTIST’S USE, FOR ADDITIONAL INFORMATION, DIAGNOSIS, PROCEDURES, OR SPECIAL CONSIDERATION</Value><Style><FontFamily>Arial</FontFamily><FontSize>5.5pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox>
