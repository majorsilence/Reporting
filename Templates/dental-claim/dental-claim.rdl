      <Textbox Name="T107"><Top>5.56in</Top><Left>4.9in</Left><Width>1.85in</Width><Height>0.17in</Height><Value>Spouse’s birthdate (YYYY/MM/DD)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T108"><Top>5.56in</Top><Left>6.75in</Left><Width>1.05in</Width><Height>0.17in</Height><Value>=First(Fields!SpouseBirthdate.Value, "Claim")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><BorderStyle><Bottom>Solid</Bottom></BorderStyle><BorderWidth><Default>.5pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>2pt</PaddingLeft></Style></Textbox>
      <Textbox Name="T109"><Top>5.77in</Top><Left>0in</Left><Width>0.17in</Width><Height>0.17in</Height><Value>6.</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T110"><Top>5.77in</Top><Left>0.17in</Left><Width>3.0in</Width><Height>0.17in</Height><Value>Are any of the services provided as a result of an accident?</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T111"><Top>5.795in</Top><Left>3.2in</Left><Width>0.12in</Width><Height>0.12in</Height><Value>=IIf(First(Fields!Accident.Value, "Claim") = "No", "X", "")</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom><VerticalAlign>Middle</VerticalAlign></Style></Textbox><Textbox Name="T112"><Top>5.77in</Top><Left>3.3400000000000003in</Left><Width>0.3in</Width><Height>0.17in</Height><Value>No</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox><Textbox Name="T113"><Top>5.795in</Top><Left>3.6500000000000004in</Left><Width>0.12in</Width><Height>0.12in</Height><Value>=IIf(First(Fields!Accident.Value, "Claim") = "Yes", "X", "")</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom><VerticalAlign>Middle</VerticalAlign></Style></Textbox><Textbox Name="T114"><Top>5.77in</Top><Left>3.7900000000000005in</Left><Width>0.3in</Width><Height>0.17in</Height><Value>Yes</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T115"><Top>5.97in</Top><Left>0.17in</Left><Width>2.6in</Width><Height>0.17in</Height><Value>If “Yes,” provide the date and details of the accident.</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T116"><Top>5.97in</Top><Left>2.75in</Left><Width>5.05in</Width><Height>0.17in</Height><Value>=First(Fields!AccidentDetails.Value, "Claim")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><BorderStyle><Bottom>Solid</Bottom></BorderStyle><BorderWidth><Default>.5pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>2pt</PaddingLeft></Style></Textbox>
      <Textbox Name="T117"><Top>6.18in</Top><Left>0in</Left><Width>0.17in</Width><Height>0.17in</Height><Value>7.</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T118"><Top>6.18in</Top><Left>0.17in</Left><Width>3.1in</Width><Height>0.17in</Height><Value>Are you claiming for a dependent child who is age 21 or older?</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T119"><Top>6.205in</Top><Left>3.3in</Left><Width>0.12in</Width><Height>0.12in</Height><Value>=IIf(First(Fields!DependentOver21.Value, "Claim") = "No", "X", "")</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom><VerticalAlign>Middle</VerticalAlign></Style></Textbox><Textbox Name="T120"><Top>6.18in</Top><Left>3.44in</Left><Width>0.3in</Width><Height>0.17in</Height><Value>No</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox><Textbox Name="T121"><Top>6.205in</Top><Left>3.75in</Left><Width>0.12in</Width><Height>0.12in</Height><Value>=IIf(First(Fields!DependentOver21.Value, "Claim") = "Yes", "X", "")</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom><VerticalAlign>Middle</VerticalAlign></Style></Textbox><Textbox Name="T122"><Top>6.18in</Top><Left>3.89in</Left><Width>0.3in</Width><Height>0.17in</Height><Value>Yes</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T123"><Top>6.359999999999999in</Top><Left>0.17in</Left><Width>2.25in</Width><Height>0.17in</Height><Value>If the patient is a dependent child, the child:</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T124"><Top>6.385in</Top><Left>2.45in</Left><Width>0.12in</Width><Height>0.12in</Height><Value>=IIf(First(Fields!ChildDisabled.Value, "Claim") = "Yes", "X", "")</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom><VerticalAlign>Middle</VerticalAlign></Style></Textbox><Textbox Name="T125"><Top>6.359999999999999in</Top><Left>2.5900000000000003in</Left><Width>2.0in</Width><Height>0.17in</Height><Value>has a physical or mental disability</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T126"><Top>6.555in</Top><Left>2.45in</Left><Width>0.12in</Width><Height>0.12in</Height><Value>=IIf(First(Fields!ChildStudent.Value, "Claim") = "Yes", "X", "")</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom><VerticalAlign>Middle</VerticalAlign></Style></Textbox><Textbox Name="T127"><Top>6.529999999999999in</Top><Left>2.5900000000000003in</Left><Width>2.05in</Width><Height>0.17in</Height><Value>is a student (school’s name and location)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T128"><Top>6.529999999999999in</Top><Left>4.65in</Left><Width>3.15in</Width><Height>0.17in</Height><Value>=First(Fields!SchoolName.Value, "Claim")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><BorderStyle><Bottom>Solid</Bottom></BorderStyle><BorderWidth><Default>.5pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>2pt</PaddingLeft></Style></Textbox>
      <Textbox Name="T129"><Top>6.72in</Top><Left>2.45in</Left><Width>2.6in</Width><Height>0.17in</Height><Value>=First(Fields!StudyDates.Value, "Claim")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><BorderStyle><Bottom>Solid</Bottom></BorderStyle><BorderWidth><Default>.5pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>2pt</PaddingLeft></Style></Textbox>
      <Textbox Name="T130"><Top>6.72in</Top><Left>5.1in</Left><Width>1.6in</Width><Height>0.17in</Height><Value>Dates of studies (YYYY/MM/DD)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T131"><Top>6.93in</Top><Left>0in</Left><Width>0.17in</Width><Height>0.17in</Height><Value>8.</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T132"><Top>6.93in</Top><Left>0.17in</Left><Width>3.45in</Width><Height>0.17in</Height><Value>If treatment is a denture, crown or bridge, is it an initial placement?</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T133"><Top>6.955in</Top><Left>3.65in</Left><Width>0.12in</Width><Height>0.12in</Height><Value>=IIf(First(Fields!InitialPlacement.Value, "Claim") = "No", "X", "")</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom><VerticalAlign>Middle</VerticalAlign></Style></Textbox><Textbox Name="T134"><Top>6.93in</Top><Left>3.79in</Left><Width>0.3in</Width><Height>0.17in</Height><Value>No</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox><Textbox Name="T135"><Top>6.955in</Top><Left>4.1in</Left><Width>0.12in</Width><Height>0.12in</Height><Value>=IIf(First(Fields!InitialPlacement.Value, "Claim") = "Yes", "X", "")</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom><VerticalAlign>Middle</VerticalAlign></Style></Textbox><Textbox Name="T136"><Top>6.93in</Top><Left>4.239999999999999in</Left><Width>0.3in</Width><Height>0.17in</Height><Value>Yes</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T137"><Top>7.12in</Top><Left>0.17in</Left><Width>3.35in</Width><Height>0.17in</Height><Value>If “No,” provide the last placement date and reason for replacement.</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T138"><Top>7.12in</Top><Left>3.5in</Left><Width>4.3in</Width><Height>0.17in</Height><Value>=First(Fields!PlacementDetails.Value, "Claim")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><BorderStyle><Bottom>Solid</Bottom></BorderStyle><BorderWidth><Default>.5pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>2pt</PaddingLeft></Style></Textbox>
      <Textbox Name="T139"><Top>7.33in</Top><Left>0in</Left><Width>0.17in</Width><Height>0.17in</Height><Value>9.</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T140"><Top>7.33in</Top><Left>0.17in</Left><Width>2.6in</Width><Height>0.17in</Height><Value>Is any treatment required for orthodontic purposes?</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T141"><Top>7.355in</Top><Left>2.8in</Left><Width>0.12in</Width><Height>0.12in</Height><Value>=IIf(First(Fields!Orthodontic.Value, "Claim") = "No", "X", "")</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom><VerticalAlign>Middle</VerticalAlign></Style></Textbox><Textbox Name="T142"><Top>7.33in</Top><Left>2.94in</Left><Width>0.3in</Width><Height>0.17in</Height><Value>No</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox><Textbox Name="T143"><Top>7.355in</Top><Left>3.25in</Left><Width>0.12in</Width><Height>0.12in</Height><Value>=IIf(First(Fields!Orthodontic.Value, "Claim") = "Yes", "X", "")</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom><VerticalAlign>Middle</VerticalAlign></Style></Textbox><Textbox Name="T144"><Top>7.33in</Top><Left>3.39in</Left><Width>0.3in</Width><Height>0.17in</Height><Value>Yes</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
      <Textbox Name="T145"><Top>7.58in</Top><Left>0in</Left><Width>7.8in</Width><Height>0.26in</Height><Value>I certify that the information on this form is accurate and complete to the best of my knowledge and that it relates to services received by me and/or my eligible family members. If I am claiming on behalf of my spouse or dependents, I am authorized to share their information for the purpose of assessing and paying this claim.</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize></Style></Textbox>
      <Textbox Name="T146"><Top>7.89in</Top><Left>0in</Left><Width>7.8in</Width><Height>0.26in</Height><Value>If any part of this claim is to be paid from my Health Spending Account, I confirm that the expense qualifies as a medical expense for income tax purposes and that the persons claimed for are eligible under that account. I am responsible for any taxes that may result from the reimbursement of these expenses.</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize></Style></Textbox>
      <Textbox Name="T147"><Top>8.2in</Top><Left>0in</Left><Width>7.8in</Width><Height>0.36in</Height><Value>="I authorize " &amp; First(Fields!PlanName.Value, "Claim") &amp; " and " &amp; First(Fields!InsurerName.Value, "Claim") &amp; " to collect, use, keep and share the personal information relevant to this claim as needed to administer the plan, assess, investigate and manage this claim, and determine eligibility, including with health professionals and facilities, other insurers and service providers. This authorization also covers my dependents, insofar as it applies to administering their benefits. A copy of this authorization is as valid as the original."</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize></Style></Textbox>
      <Textbox Name="T148"><Top>8.7in</Top><Left>0in</Left><Width>1.45in</Width><Height>0.17in</Height><Value>Signature of Employee</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox>
      <Line Name="L149"><Top>8.86in</Top><Left>1.45in</Left><Width>3.75in</Width><Height>0in</Height><Style><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>Black</Default></BorderColor><BorderWidth><Default>.5pt</Default></BorderWidth></Style></Line>
      <Textbox Name="T150"><Top>8.7in</Top><Left>5.35in</Left><Width>0.35in</Width><Height>0.17in</Height><Value>Date</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></Textbox>
      <Line Name="L151"><Top>8.86in</Top><Left>5.7in</Left><Width>2.1in</Width><Height>0in</Height><Style><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>Black</Default></BorderColor><BorderWidth><Default>.5pt</Default></BorderWidth></Style></Line>
      <Rectangle Name="InstructionsPage"><Top>8.95in</Top><Left>0in</Left><Width>7.8in</Width><Height>3.6in</Height><PageBreakAtStart>true</PageBreakAtStart><ReportItems><Textbox Name="T152"><Top>0.25in</Top><Left>0in</Left><Width>7.8in</Width><Height>0.25in</Height><Value>INSTRUCTIONS (Please read carefully)</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign></Style></Textbox>
<Textbox Name="T153"><Top>0.55in</Top><Left>0in</Left><Width>7.8in</Width><Height>0.5in</Height><Value>="The Dentist completes part 1. The Employee completes part 2." &amp; Chr(10) &amp; "Please ensure all questions are answered or your claim may take longer to process." &amp; Chr(10) &amp; "Send completed claim form to:"</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Center</TextAlign></Style></Textbox>
<Textbox Name="T154"><Top>1.05in</Top><Left>0in</Left><Width>7.8in</Width><Height>0.62in</Height><Value>=First(Fields!PlanName.Value, "Claim") &amp; Chr(10) &amp; First(Fields!ClaimsAddress.Value, "Claim") &amp; Chr(10) &amp; "Telephone " &amp; First(Fields!Phone.Value, "Claim") &amp; " • Fax " &amp; First(Fields!Fax.Value, "Claim")</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign></Style></Textbox>
<Rectangle Name="Promo"><Top>2.1in</Top><Left>1.3in</Left><Width>5.2in</Width><Height>1.4in</Height><ReportItems><Textbox Name="T155"><Top>0.25in</Top><Left>0.2in</Left><Width>1.8in</Width><Height>0.55in</Height><Value>eClaims</Value><Style><FontFamily>Arial</FontFamily><FontSize>26pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><Color>#233C6E</Color><FontStyle>Italic</FontStyle><Color>#233C6E</Color></Style></Textbox>
<Textbox Name="T156"><Top>0.8in</Top><Left>0.2in</Left><Width>1.8in</Width><Height>0.2in</Height><Value>fast • secure • paperless</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Center</TextAlign><Color>#D68910</Color></Style></Textbox>
<Textbox Name="T157"><Top>0.2in</Top><Left>2.3in</Left><Width>2.7in</Width><Height>0.18in</Height><Value>WANT TO GET YOUR CLAIM PAID FASTER?</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox>
<Textbox Name="T158"><Top>0.38in</Top><Left>2.3in</Left><Width>2.7in</Width><Height>0.18in</Height><Value>SUBMIT YOUR CLAIMS ONLINE</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#D68910</Color></Style></Textbox>
<Textbox Name="T159"><Top>0.62in</Top><Left>2.3in</Left><Width>2.75in</Width><Height>0.62in</Height><Value>="• Go to " &amp; First(Fields!Website.Value, "Claim") &amp; " and register for the plan member secure site" &amp; Chr(10) &amp; "• Sign up for direct deposit" &amp; Chr(10) &amp; "• Submit claims online and save time, paper and money!" &amp; Chr(10) &amp; "• Download the mobile app from your app store"</Value><Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize></Style></Textbox></ReportItems><Style><BackgroundColor>#FBF1DF</BackgroundColor></Style></Rectangle></ReportItems></Rectangle>
    </ReportItems>
  </Body>

