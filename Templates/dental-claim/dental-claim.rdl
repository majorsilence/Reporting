<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Group-benefits dental claim form -- dentist and patient sections, a procedure grid with fee totals, the employee's statement with Yes/No checkboxes, and an instructions page. Prints blank or pre-filled.</Description>
  <PageHeight>11in</PageHeight>
  <PageWidth>8.5in</PageWidth>
  <TopMargin>.25in</TopMargin>
  <LeftMargin>.35in</LeftMargin>
  <RightMargin>.35in</RightMargin>
  <BottomMargin>.25in</BottomMargin>
  <Width>7.8in</Width>

  <EmbeddedImages>
    <EmbeddedImage Name="PlanLogo">
      <MIMEType>image/png</MIMEType>
      <ImageData></ImageData>
    </EmbeddedImage>
  </EmbeddedImages>

  <DataSources>
    <DataSource Name="DS1">
      <ConnectionProperties>
        <DataProvider>Json</DataProvider>
        <ConnectString>file=sample-data.json</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="Claim">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>columns=PlanName,InsurerName,InsurerLegalName,FormCode,FormRevision,ClaimsAddress,Phone,Fax,Website,FirmNumber,CertificateNumber,DentistUniqueNo,DentistSpecialty,PatientAccountNo,DentistInfo,DentistPhone,DentistNotes,PatientName,PatientAddress,PatientCity,PatientProvince,PatientPostalCode,Employer,EmployeeName,EmployeeAddress,EmployeeCity,EmployeeProvince,EmployeePostalCode,EmployeeBirthdate,PatientRelationship,PatientBirthdate,HsaApply,OtherCoverage,FamilyMemberInsured,OtherInsurer,SpouseBirthdate,Accident,AccidentDetails,DependentOver21,ChildDisabled,ChildStudent,SchoolName,StudyDates,InitialPlacement,PlacementDetails,Orthodontic;table=root</CommandText>
      </Query>
      <Fields>
        <Field Name="PlanName"><DataField>PlanName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="InsurerName"><DataField>InsurerName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="InsurerLegalName"><DataField>InsurerLegalName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="FormCode"><DataField>FormCode</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="FormRevision"><DataField>FormRevision</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ClaimsAddress"><DataField>ClaimsAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Phone"><DataField>Phone</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Fax"><DataField>Fax</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Website"><DataField>Website</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="FirmNumber"><DataField>FirmNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CertificateNumber"><DataField>CertificateNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="DentistUniqueNo"><DataField>DentistUniqueNo</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="DentistSpecialty"><DataField>DentistSpecialty</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PatientAccountNo"><DataField>PatientAccountNo</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="DentistInfo"><DataField>DentistInfo</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="DentistPhone"><DataField>DentistPhone</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="DentistNotes"><DataField>DentistNotes</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PatientName"><DataField>PatientName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PatientAddress"><DataField>PatientAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PatientCity"><DataField>PatientCity</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PatientProvince"><DataField>PatientProvince</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PatientPostalCode"><DataField>PatientPostalCode</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Employer"><DataField>Employer</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="EmployeeName"><DataField>EmployeeName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="EmployeeAddress"><DataField>EmployeeAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="EmployeeCity"><DataField>EmployeeCity</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="EmployeeProvince"><DataField>EmployeeProvince</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="EmployeePostalCode"><DataField>EmployeePostalCode</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="EmployeeBirthdate"><DataField>EmployeeBirthdate</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PatientRelationship"><DataField>PatientRelationship</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PatientBirthdate"><DataField>PatientBirthdate</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="HsaApply"><DataField>HsaApply</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="OtherCoverage"><DataField>OtherCoverage</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="FamilyMemberInsured"><DataField>FamilyMemberInsured</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="OtherInsurer"><DataField>OtherInsurer</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="SpouseBirthdate"><DataField>SpouseBirthdate</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Accident"><DataField>Accident</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="AccidentDetails"><DataField>AccidentDetails</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="DependentOver21"><DataField>DependentOver21</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ChildDisabled"><DataField>ChildDisabled</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ChildStudent"><DataField>ChildStudent</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="SchoolName"><DataField>SchoolName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="StudyDates"><DataField>StudyDates</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="InitialPlacement"><DataField>InitialPlacement</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PlacementDetails"><DataField>PlacementDetails</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Orthodontic"><DataField>Orthodontic</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="Lines">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>columns=ServiceDate,ProcedureCode,ToothCode,ToothSurfaces,DentistFee,LabCharge;table=root_Lines</CommandText>
      </Query>
      <Fields>
        <Field Name="ServiceDate"><DataField>ServiceDate</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ProcedureCode"><DataField>ProcedureCode</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ToothCode"><DataField>ToothCode</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ToothSurfaces"><DataField>ToothSurfaces</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="DentistFee"><DataField>DentistFee</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
        <Field Name="LabCharge"><DataField>LabCharge</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>

  <PageHeader>
    <Height>.9in</Height>
    <PrintOnFirstPage>true</PrintOnFirstPage>
    <PrintOnLastPage>true</PrintOnLastPage>
    <ReportItems>
      <Image Name="Logo"><Top>0in</Top><Left>0in</Left><Width>2.35in</Width><Height>.41in</Height><Source>Embedded</Source><Value>PlanLogo</Value><Sizing>FitProportional</Sizing></Image>
      <CustomReportItem Name="FormBarcode"><Type>BarCode128</Type><Top>0in</Top><Left>5.55in</Left><Width>2.25in</Width><Height>.44in</Height><CustomProperties><CustomProperty><Name>Code</Name><Value>=First(Fields!FormCode.Value, "Claim")</Value></CustomProperty></CustomProperties></CustomReportItem>
      <Line Name="L1"><Top>0.5in</Top><Left>0in</Left><Width>7.8in</Width><Height>0in</Height><Style><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>Black</Default></BorderColor><BorderWidth><Default>1pt</Default></BorderWidth></Style></Line>
      <Textbox Name="T2"><Top>0.55in</Top><Left>0in</Left><Width>2.2in</Width><Height>0.3in</Height><Value>Dental Claim</Value><Style><FontFamily>Arial</FontFamily><FontSize>16pt</FontSize><Color>#D68910</Color></Style></Textbox>
      <Textbox Name="T3"><Top>0.66in</Top><Left>3.3in</Left><Width>2.0in</Width><Height>0.17in</Height><Visibility><Hidden>=Globals!PageNumber &gt; 1</Hidden></Visibility><Value>Please print your Firm &amp; Certificate #</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign></Style></Textbox>
      <Textbox Name="T4"><Top>0.52in</Top><Left>5.4in</Left><Width>1.05in</Width><Height>0.12in</Height><Visibility><Hidden>=Globals!PageNumber &gt; 1</Hidden></Visibility><Value>Firm #</Value><Style><FontFamily>Arial</FontFamily><FontSize>6pt</FontSize><BorderStyle><Left>Solid</Left></BorderStyle><BorderWidth><Default>.5pt</Default></BorderWidth></Style></Textbox>
      <Textbox Name="T5"><Top>0.64in</Top><Left>5.4in</Left><Width>1.05in</Width><Height>0.22in</Height><Visibility><Hidden>=Globals!PageNumber &gt; 1</Hidden></Visibility><Value>=First(Fields!FirmNumber.Value, "Claim")</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><BorderStyle><Left>Solid</Left></BorderStyle><BorderWidth><Default>.5pt</Default></BorderWidth><PaddingLeft>4pt</PaddingLeft></Style></Textbox>
      <Textbox Name="T6"><Top>0.52in</Top><Left>6.55in</Left><Width>1.25in</Width><Height>0.12in</Height><Visibility><Hidden>=Globals!PageNumber &gt; 1</Hidden></Visibility><Value>Certificate #</Value><Style><FontFamily>Arial</FontFamily><FontSize>6pt</FontSize><BorderStyle><Left>Solid</Left></BorderStyle><BorderWidth><Default>.5pt</Default></BorderWidth></Style></Textbox>
      <Textbox Name="T7"><Top>0.64in</Top><Left>6.55in</Left><Width>1.25in</Width><Height>0.22in</Height><Visibility><Hidden>=Globals!PageNumber &gt; 1</Hidden></Visibility><Value>=First(Fields!CertificateNumber.Value, "Claim")</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><BorderStyle><Left>Solid</Left></BorderStyle><BorderWidth><Default>.5pt</Default></BorderWidth><PaddingLeft>4pt</PaddingLeft></Style></Textbox>
    </ReportItems>
  </PageHeader>

  <Body>
    <Height>12.549999999999999in</Height>
    <ReportItems>
