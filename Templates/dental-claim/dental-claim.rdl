      <Textbox Name="T70"><Top>3.26in</Top><Left>5.05in</Left><Width>2.75in</Width><Height>0.3in</Height><Value>I hereby assign my benefits payable from this claim and authorize payment directly to the named Dentist.</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox>
