<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Phone/internet/TV bill -- account summary with computed section totals and tax, a detachable payment stub, last-bill balance, and per-service charge sections.</Description>
  <PageHeight>11in</PageHeight>
  <PageWidth>8.5in</PageWidth>
  <TopMargin>.4in</TopMargin>
  <LeftMargin>.65in</LeftMargin>
  <RightMargin>.65in</RightMargin>
  <BottomMargin>.35in</BottomMargin>
  <Width>7.2in</Width>

  <EmbeddedImages>
    <EmbeddedImage Name="ProviderLogo">
      <MIMEType>image/png</MIMEType>
      <ImageData></ImageData>
    </EmbeddedImage>
  </EmbeddedImages>

  <DataSources>
    <DataSource Name="DS1">
      <ConnectionProperties>
        <DataProvider>Json</DataProvider>
        <ConnectString>file=sample-data.json</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="Account">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>columns=ProviderName,ProviderRemitAddress,Website,ContactInfo,TaxName,TaxRate,TaxRegistration,LateFeeText,CustomerName,MailingAddress,AccountNumber,MainPhone,BillDate,PayBy,PreviousAmountDue,PaymentReceived,PaymentDate;table=root</CommandText>
      </Query>
      <Fields>
        <Field Name="ProviderName"><DataField>ProviderName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ProviderRemitAddress"><DataField>ProviderRemitAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Website"><DataField>Website</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ContactInfo"><DataField>ContactInfo</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="TaxName"><DataField>TaxName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="TaxRate"><DataField>TaxRate</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
        <Field Name="TaxRegistration"><DataField>TaxRegistration</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="LateFeeText"><DataField>LateFeeText</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CustomerName"><DataField>CustomerName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="MailingAddress"><DataField>MailingAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="AccountNumber"><DataField>AccountNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="MainPhone"><DataField>MainPhone</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="BillDate"><DataField>BillDate</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PayBy"><DataField>PayBy</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PreviousAmountDue"><DataField>PreviousAmountDue</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
        <Field Name="PaymentReceived"><DataField>PaymentReceived</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
        <Field Name="PaymentDate"><DataField>PaymentDate</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="Sections">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>columns=Code,Name,SortOrder,ChargesFor,Period,Includes;table=root_Sections</CommandText>
      </Query>
      <Fields>
        <Field Name="Code"><DataField>Code</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Name"><DataField>Name</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="SortOrder"><DataField>SortOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="ChargesFor"><DataField>ChargesFor</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Period"><DataField>Period</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Includes"><DataField>Includes</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="Charges">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>columns=Section,Description,Amount;table=root_Charges</CommandText>
      </Query>
      <Fields>
        <Field Name="Section"><DataField>Section</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Description"><DataField>Description</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Amount"><DataField>Amount</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>

  <PageHeader>
    <Height>.6in</Height>
    <PrintOnFirstPage>false</PrintOnFirstPage>
    <PrintOnLastPage>true</PrintOnLastPage>
    <ReportItems>
      <Image Name="HeaderLogo"><Top>0in</Top><Left>0in</Left><Width>1.5in</Width><Height>0.3in</Height><Source>Embedded</Source><Value>ProviderLogo</Value><Sizing>FitProportional</Sizing></Image>
      <Textbox Name="T54"><Top>0.03in</Top><Left>2.0in</Left><Width>2.5in</Width><Height>0.2in</Height><Value>=First(Fields!CustomerName.Value, "Account")</Value><Style><FontFamily>Arial</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T55"><Top>0in</Top><Left>4.7in</Left><Width>1.0in</Width><Height>0.15in</Height><Value>Account number</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T56"><Top>0in</Top><Left>5.7in</Left><Width>1.5in</Width><Height>0.15in</Height><Value>=First(Fields!AccountNumber.Value, "Account")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T57"><Top>0.15in</Top><Left>4.7in</Left><Width>1.0in</Width><Height>0.15in</Height><Value>Bill date</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T58"><Top>0.15in</Top><Left>5.7in</Left><Width>1.5in</Width><Height>0.15in</Height><Value>=Format(CDate(First(Fields!BillDate.Value, "Account")), "MMMM d, yyyy")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
    </ReportItems>
  </PageHeader>

  <Body>
    <Height>13.2in</Height>
    <ReportItems>
      <Image Name="Logo"><Top>0in</Top><Left>0in</Left><Width>2.1in</Width><Height>0.41in</Height><Source>Embedded</Source><Value>ProviderLogo</Value><Sizing>FitProportional</Sizing></Image>
      <Textbox Name="T1"><Top>0.7in</Top><Left>0in</Left><Width>3in</Width><Height>0.32in</Height><Value>Your Bill</Value><Style><FontFamily>Arial</FontFamily><FontSize>20pt</FontSize><Color>#555555</Color><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T2"><Top>1.0in</Top><Left>3.75in</Left><Width>3.45in</Width><Height>0.22in</Height><Value>=First(Fields!CustomerName.Value, "Account")</Value><Style><FontFamily>Arial</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T3"><Top>1.22in</Top><Left>3.75in</Left><Width>3.45in</Width><Height>0.17in</Height><Value>="Account number: " &amp; First(Fields!AccountNumber.Value, "Account")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T4"><Top>1.4in</Top><Left>0in</Left><Width>3.4in</Width><Height>0.2in</Height><Value>=Format(CDate(First(Fields!BillDate.Value, "Account")), "MMMM d, yyyy")</Value><Style><FontFamily>Arial</FontFamily><FontSize>10pt</FontSize><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T5"><Top>1.65in</Top><Left>0in</Left><Width>3.4in</Width><Height>0.17in</Height><Value>="Main Phone number : " &amp; First(Fields!MainPhone.Value, "Account")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T6"><Top>1.5in</Top><Left>3.75in</Left><Width>3.45in</Width><Height>0.22in</Height><Value>Questions?</Value><Style><FontFamily>Arial</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T7"><Top>1.72in</Top><Left>3.75in</Left><Width>3.45in</Width><Height>0.62in</Height><CanGrow>true</CanGrow><Value>=First(Fields!ContactInfo.Value, "Account")</Value><Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T8"><Top>2.1in</Top><Left>0in</Left><Width>3.6in</Width><Height>0.26in</Height><Value>Summary of your charges</Value><Style><FontFamily>Arial</FontFamily><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Rectangle Name="Summary"><Top>2.42in</Top><Left>0in</Left><Width>3.6in</Width><Height>2.4in</Height><ReportItems><Textbox Name="T9"><Top>0in</Top><Left>0in</Left><Width>2.6in</Width><Height>0.18in</Height><Value>Balance owing from last bill</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><BorderStyle><Bottom>Dotted</Bottom></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign></Style></Textbox><Textbox Name="T10"><Top>0in</Top><Left>2.6in</Left><Width>1.0in</Width><Height>0.18in</Height><Value>=Format((First(Fields!PreviousAmountDue.Value, "Account") - First(Fields!PaymentReceived.Value, "Account")), "$#,##0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><BorderStyle><Bottom>Dotted</Bottom></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign></Style></Textbox>
<Table Name="SectionSummary"><DataSetName>Charges</DataSetName><Top>.2in</Top><Left>0in</Left><TableColumns><TableColumn><Width>2.6in</Width></TableColumn><TableColumn><Width>1.0in</Width></TableColumn></TableColumns><Details><TableRows><TableRow><Height>.18in</Height><TableCells><TableCell><ReportItems><Textbox Name="S_Name"><Value>=Lookup(Fields!Section.Value, Fields!Code.Value, Fields!Name.Value, "Sections")</Value><CanGrow>true</CanGrow><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><VerticalAlign>Bottom</VerticalAlign><BorderStyle><Bottom>Dotted</Bottom></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="S_Amt"><Value>=Format(Sum(Fields!Amount.Value), "$#,##0.00")</Value><CanGrow>true</CanGrow><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><VerticalAlign>Bottom</VerticalAlign><BorderStyle><Bottom>Dotted</Bottom></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth></Style></Textbox></ReportItems></TableCell></TableCells></TableRow></TableRows><Grouping Name="SummaryBySection"><GroupExpressions><GroupExpression>=Fields!Section.Value</GroupExpression></GroupExpressions></Grouping><Sorting><SortBy><SortExpression>=Lookup(Fields!Section.Value, Fields!Code.Value, Fields!SortOrder.Value, "Sections")</SortExpression><Direction>Ascending</Direction></SortBy></Sorting></Details></Table>
<Textbox Name="T11"><Top>0.4in</Top><Left>0in</Left><Width>2.6in</Width><Height>0.18in</Height><Value>="Total " &amp; First(Fields!TaxName.Value, "Account")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><VerticalAlign>Bottom</VerticalAlign></Style></Textbox><Textbox Name="T12"><Top>0.4in</Top><Left>2.6in</Left><Width>1.0in</Width><Height>0.18in</Height><Value>=Format(Round(Sum(Fields!Amount.Value, "Charges") * First(Fields!TaxRate.Value, "Account"), 2), "$#,##0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><VerticalAlign>Bottom</VerticalAlign></Style></Textbox>
<Textbox Name="T13"><Top>0.6in</Top><Left>0in</Left><Width>2.6in</Width><Height>0.2in</Height><Value>Total new charges</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><BorderStyle><Top>Solid</Top></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign></Style></Textbox><Textbox Name="T14"><Top>0.6in</Top><Left>2.6in</Left><Width>1.0in</Width><Height>0.2in</Height><Value>=Format((Sum(Fields!Amount.Value, "Charges") + Round(Sum(Fields!Amount.Value, "Charges") * First(Fields!TaxRate.Value, "Account"), 2)), "$#,##0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><BorderStyle><Top>Solid</Top></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign></Style></Textbox>
<Textbox Name="T15"><Top>0.82in</Top><Left>0in</Left><Width>2.6in</Width><Height>0.22in</Height><Value>Total due</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><VerticalAlign>Bottom</VerticalAlign></Style></Textbox><Textbox Name="T16"><Top>0.82in</Top><Left>2.6in</Left><Width>1.0in</Width><Height>0.22in</Height><Value>=Format(((First(Fields!PreviousAmountDue.Value, "Account") - First(Fields!PaymentReceived.Value, "Account")) + Sum(Fields!Amount.Value, "Charges") + Round(Sum(Fields!Amount.Value, "Charges") * First(Fields!TaxRate.Value, "Account"), 2)), "$#,##0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><VerticalAlign>Bottom</VerticalAlign></Style></Textbox>
<Textbox Name="T17"><Top>1.06in</Top><Left>0in</Left><Width>2.6in</Width><Height>0.45in</Height><Value>="Payment due upon receipt" &amp; Chr(10) &amp; "To ensure your payment is reflected on your next" &amp; Chr(10) &amp; "invoice, please pay by: " &amp; Format(CDate(First(Fields!PayBy.Value, "Account")), "MMMM d, yyyy")</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontStyle>Italic</FontStyle><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox></ReportItems></Rectangle>
      <Textbox Name="T18"><Top>4.95in</Top><Left>0in</Left><Width>7.2in</Width><Height>0.15in</Height><Value>="Total " &amp; First(Fields!TaxName.Value, "Account") &amp; " (" &amp; First(Fields!ProviderName.Value, "Account") &amp; " registration # " &amp; First(Fields!TaxRegistration.Value, "Account") &amp; ") is " &amp; Format(Round(Sum(Fields!Amount.Value, "Charges") * First(Fields!TaxRate.Value, "Account"), 2), "$#,##0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize><FontStyle>Italic</FontStyle><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T19"><Top>5.6in</Top><Left>0in</Left><Width>6.0in</Width><Height>0.3in</Height><Value>=First(Fields!LateFeeText.Value, "Account")</Value><Style><FontFamily>Arial</FontFamily><FontSize>5.5pt</FontSize><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T20"><Top>5.62in</Top><Left>6.0in</Left><Width>1.2in</Width><Height>0.2in</Height><Value>="Page 1 of " &amp; Globals!TotalPages</Value><Style><FontFamily>Arial</FontFamily><FontSize>10pt</FontSize><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Line Name="CutLine"><Top>6.0in</Top><Left>0in</Left><Width>7.2in</Width><Height>0in</Height><Style><BorderStyle><Default>Dashed</Default></BorderStyle><BorderColor><Default>#999999</Default></BorderColor><BorderWidth><Default>.75pt</Default></BorderWidth></Style></Line>
      <Image Name="StubLogo"><Top>6.2in</Top><Left>0.05in</Left><Width>1.3in</Width><Height>0.26in</Height><Source>Embedded</Source><Value>ProviderLogo</Value><Sizing>FitProportional</Sizing></Image>
      <Textbox Name="T21"><Top>6.55in</Top><Left>0.05in</Left><Width>2.0in</Width><Height>0.35in</Height><Value>=First(Fields!ProviderRemitAddress.Value, "Account")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T22"><Top>6.2in</Top><Left>2.25in</Left><Width>2.1in</Width><Height>0.25in</Height><Value>Payment stub</Value><Style><FontFamily>Arial</FontFamily><FontSize>13pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T23"><Top>6.45in</Top><Left>2.25in</Left><Width>2.0in</Width><Height>0.3in</Height><Value>See over for information about your payment options.</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T24"><Top>6.45in</Top><Left>4.7in</Left><Width>1.0in</Width><Height>0.15in</Height><Value>Account number</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T25"><Top>6.45in</Top><Left>5.7in</Left><Width>1.5in</Width><Height>0.15in</Height><Value>=First(Fields!AccountNumber.Value, "Account")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T26"><Top>6.595in</Top><Left>4.7in</Left><Width>1.0in</Width><Height>0.15in</Height><Value>Bill date</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T27"><Top>6.595in</Top><Left>5.7in</Left><Width>1.5in</Width><Height>0.15in</Height><Value>=Format(CDate(First(Fields!BillDate.Value, "Account")), "MMMM d, yyyy")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T28"><Top>6.74in</Top><Left>4.7in</Left><Width>1.0in</Width><Height>0.15in</Height><Value>Please pay by</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T29"><Top>6.74in</Top><Left>5.7in</Left><Width>1.5in</Width><Height>0.15in</Height><Value>=Format(CDate(First(Fields!PayBy.Value, "Account")), "MMMM d, yyyy")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T30"><Top>6.885in</Top><Left>4.7in</Left><Width>1.0in</Width><Height>0.15in</Height><Value>Total due</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Textbox Name="T31"><Top>6.885in</Top><Left>5.7in</Left><Width>1.5in</Width><Height>0.15in</Height><Value>=Format(((First(Fields!PreviousAmountDue.Value, "Account") - First(Fields!PaymentReceived.Value, "Account")) + Sum(Fields!Amount.Value, "Charges") + Round(Sum(Fields!Amount.Value, "Charges") * First(Fields!TaxRate.Value, "Account"), 2)), "$#,##0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Rectangle Name="AmountPaid"><Top>7.27in</Top><Left>5.75in</Left><Width>1.45in</Width><Height>0.58in</Height><Style><BorderStyle><Default>Solid</Default></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth></Style><ReportItems><Textbox Name="T32"><Top>0.05in</Top><Left>0.07in</Left><Width>1.3in</Width><Height>0.16in</Height><Value>Amount paid</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
<Textbox Name="T33"><Top>0.26in</Top><Left>0.07in</Left><Width>1.3in</Width><Height>0.25in</Height><Value>$</Value><Style><FontFamily>Arial</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox></ReportItems></Rectangle>
      <Textbox Name="T34"><Top>7.55in</Top><Left>0.2in</Left><Width>3.5in</Width><Height>0.55in</Height><Value>=First(Fields!CustomerName.Value, "Account") &amp; Chr(10) &amp; First(Fields!MailingAddress.Value, "Account")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>9.5pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
      <Rectangle Name="Details"><Top>8.2in</Top><Left>0in</Left><Width>7.2in</Width><Height>5.0in</Height><PageBreakAtStart>true</PageBreakAtStart><ReportItems><Textbox Name="T35"><Top>0.15in</Top><Left>0in</Left><Width>3.6in</Width><Height>0.26in</Height><Value>Balance from your last bill</Value><Style><FontFamily>Arial</FontFamily><FontSize>13pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
<Textbox Name="T36"><Top>0.45in</Top><Left>0in</Left><Width>2.6in</Width><Height>0.18in</Height><Value>Amount Due on Your Last Bill</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><BorderStyle><Bottom>Dotted</Bottom></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign></Style></Textbox><Textbox Name="T37"><Top>0.45in</Top><Left>2.6in</Left><Width>1.0in</Width><Height>0.18in</Height><Value>=Format(First(Fields!PreviousAmountDue.Value, "Account"), "$#,##0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><BorderStyle><Bottom>Dotted</Bottom></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign></Style></Textbox>
<Textbox Name="T38"><Top>0.63in</Top><Left>0in</Left><Width>2.6in</Width><Height>0.18in</Height><Value>="Payment Received " &amp; Format(CDate(First(Fields!PaymentDate.Value, "Account")), "MMM d") &amp; " - Thank you"</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><BorderStyle><Bottom>Dotted</Bottom></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign></Style></Textbox><Textbox Name="T39"><Top>0.63in</Top><Left>2.6in</Left><Width>1.0in</Width><Height>0.18in</Height><Value>=Format(-First(Fields!PaymentReceived.Value, "Account"), "$#,##0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><BorderStyle><Bottom>Dotted</Bottom></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign></Style></Textbox>
<Textbox Name="T40"><Top>0.83in</Top><Left>0in</Left><Width>2.6in</Width><Height>0.18in</Height><Value>Amount past due</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><BorderStyle><Top>Solid</Top></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign></Style></Textbox><Textbox Name="T41"><Top>0.83in</Top><Left>2.6in</Left><Width>1.0in</Width><Height>0.18in</Height><Value>=Format((First(Fields!PreviousAmountDue.Value, "Account") - First(Fields!PaymentReceived.Value, "Account")), "$#,##0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><BorderStyle><Top>Solid</Top></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign></Style></Textbox>
<List Name="SectionList"><DataSetName>Charges</DataSetName><Top>1.25in</Top><Left>0in</Left><Width>7.2in</Width><Height>1.6in</Height><Grouping Name="BySection"><GroupExpressions><GroupExpression>=Format(Lookup(Fields!Section.Value, Fields!Code.Value, Fields!SortOrder.Value, "Sections"), "00000") &amp; "|" &amp; Fields!Section.Value</GroupExpression></GroupExpressions></Grouping><ReportItems><Rectangle Name="SectionBar"><Top>0in</Top><Left>0in</Left><Width>7.2in</Width><Height>0.25in</Height><Style><BackgroundColor>#666666</BackgroundColor></Style><ReportItems><Textbox Name="T42"><Top>0.03in</Top><Left>0.3in</Left><Width>6.8in</Width><Height>0.2in</Height><Value>=UCase(Lookup(Fields!Section.Value, Fields!Code.Value, Fields!Name.Value, "Sections"))</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize><Color>White</Color><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox></ReportItems></Rectangle>
<Textbox Name="T43"><Top>0.38in</Top><Left>0in</Left><Width>3.6in</Width><Height>0.22in</Height><Value>="Charges for " &amp; Lookup(Fields!Section.Value, Fields!Code.Value, Fields!ChargesFor.Value, "Sections")</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
<Textbox Name="T44"><Top>0.63in</Top><Left>0in</Left><Width>3.6in</Width><Height>0.17in</Height><Value>="Monthly charges  (for " &amp; Lookup(Fields!Section.Value, Fields!Code.Value, Fields!Period.Value, "Sections") &amp; ")"</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
<Table Name="SectionLines"><DataSetName>Charges</DataSetName><Top>.82in</Top><Left>0in</Left><TableColumns><TableColumn><Width>2.85in</Width></TableColumn><TableColumn><Width>.75in</Width></TableColumn></TableColumns><Details><TableRows><TableRow><Height>.18in</Height><TableCells><TableCell><ReportItems><Textbox Name="C_Desc"><Value>=Fields!Description.Value</Value><CanGrow>true</CanGrow><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><VerticalAlign>Bottom</VerticalAlign><BorderStyle><Bottom>Dotted</Bottom></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="C_Amt"><Value>=Format(Fields!Amount.Value, "$#,##0.00")</Value><CanGrow>true</CanGrow><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><VerticalAlign>Bottom</VerticalAlign><BorderStyle><Bottom>Dotted</Bottom></BorderStyle><BorderWidth><Default>.75pt</Default></BorderWidth></Style></Textbox></ReportItems></TableCell></TableCells></TableRow></TableRows></Details></Table>
<Textbox Name="T45"><Top>1.02in</Top><Left>0in</Left><Width>2.85in</Width><Height>0.2in</Height><Value>="Total " &amp; Lookup(Fields!Section.Value, Fields!Code.Value, Fields!Name.Value, "Sections") &amp; " charges"</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><BorderStyle><Top>Solid</Top></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign></Style></Textbox>
<Textbox Name="T46"><Top>1.02in</Top><Left>2.85in</Left><Width>0.75in</Width><Height>0.2in</Height><Value>=Format(Sum(Fields!Amount.Value), "$#,##0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><BorderStyle><Top>Solid</Top></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth><VerticalAlign>Bottom</VerticalAlign></Style></Textbox>
<Textbox Name="T47"><Top>1.22in</Top><Left>0in</Left><Width>2.85in</Width><Height>0.18in</Height><Value>="Plus " &amp; First(Fields!TaxName.Value, "Account")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
<Textbox Name="T48"><Top>1.22in</Top><Left>2.85in</Left><Width>0.75in</Width><Height>0.18in</Height><Value>=Format(Round(Sum(Fields!Amount.Value) * First(Fields!TaxRate.Value, "Account"), 2), "$#,##0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
<Textbox Name="T49"><Top>0.4in</Top><Left>4.15in</Left><Width>3.05in</Width><Height>0.95in</Height><CanGrow>true</CanGrow><Value>=Lookup(Fields!Section.Value, Fields!Code.Value, Fields!Includes.Value, "Sections")</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox></ReportItems></List>
<Textbox Name="T50"><Top>3.2in</Top><Left>0.4in</Left><Width>3.0in</Width><Height>0.18in</Height><Value>Bill payment options</Value><Style><FontFamily>Arial</FontFamily><FontSize>9.5pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
<Textbox Name="T51"><Top>3.4in</Top><Left>0.4in</Left><Width>2.6in</Width><Height>0.7in</Height><CanGrow>true</CanGrow><Value>="Here's how you can pay your bill:" &amp; Chr(10) &amp; "• online at " &amp; First(Fields!Website.Value, "Account") &amp; " or from your bank's website" &amp; Chr(10) &amp; "• Auto-Pay (automatic monthly payments from your bank account or credit card)" &amp; Chr(10) &amp; "• at a select authorized dealer or payment centre where available"</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
<Textbox Name="T52"><Top>3.4in</Top><Left>3.2in</Left><Width>2.6in</Width><Height>0.5in</Height><CanGrow>true</CanGrow><Value>="• at most financial institutions (a service fee may apply)" &amp; Chr(10) &amp; "• by mail (please make your cheque payable to " &amp; First(Fields!ProviderName.Value, "Account") &amp; " and include the payment stub)"</Value><Style><FontFamily>Arial</FontFamily><FontSize>6.5pt</FontSize><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox>
<Textbox Name="T53"><Top>4.3in</Top><Left>0.4in</Left><Width>3.5in</Width><Height>0.55in</Height><Value>=First(Fields!ProviderName.Value, "Account") &amp; Chr(10) &amp; First(Fields!ProviderRemitAddress.Value, "Account")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>9.5pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight></Style></Textbox></ReportItems></Rectangle>
    </ReportItems>
  </Body>

