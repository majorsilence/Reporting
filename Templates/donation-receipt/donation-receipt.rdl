<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Official donation receipt for income tax purposes -- charity logo and address, donor address, gift/benefit/eligible amounts and a signature block. One receipt per page.</Description>
  <PageHeight>11in</PageHeight>
  <PageWidth>8.5in</PageWidth>
  <TopMargin>.35in</TopMargin>
  <LeftMargin>.35in</LeftMargin>
  <RightMargin>.35in</RightMargin>
  <BottomMargin>.35in</BottomMargin>
  <Width>7.8in</Width>

  <EmbeddedImages>
    <EmbeddedImage Name="CharityLogo">
      <MIMEType>image/png</MIMEType>
      <ImageData></ImageData>
    </EmbeddedImage>
    <EmbeddedImage Name="Signature">
      <MIMEType>image/png</MIMEType>
      <ImageData></ImageData>
    </EmbeddedImage>
  </EmbeddedImages>

  <DataSources>
    <DataSource Name="DS1">
      <ConnectionProperties>
        <DataProvider>Json</DataProvider>
        <ConnectString>file=sample-data.json</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="Charity">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>columns=CharityName,CharityAddress,RegistrationNumber,Website,LocationIssued,SignerName,Currency,ThankYou;table=root</CommandText>
      </Query>
      <Fields>
        <Field Name="CharityName"><DataField>CharityName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CharityAddress"><DataField>CharityAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="RegistrationNumber"><DataField>RegistrationNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Website"><DataField>Website</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="LocationIssued"><DataField>LocationIssued</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="SignerName"><DataField>SignerName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Currency"><DataField>Currency</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ThankYou"><DataField>ThankYou</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="Receipts">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>columns=ReceiptNumber,DonorName,DonorAddress,GiftDate,DateIssued,GiftAmount,BenefitAmount;table=root_Receipts</CommandText>
      </Query>
      <Fields>
        <Field Name="ReceiptNumber"><DataField>ReceiptNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="DonorName"><DataField>DonorName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="DonorAddress"><DataField>DonorAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="GiftDate"><DataField>GiftDate</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="DateIssued"><DataField>DateIssued</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="GiftAmount"><DataField>GiftAmount</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
        <Field Name="BenefitAmount"><DataField>BenefitAmount</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>

  <Body>
    <Height>3.4in</Height>
    <ReportItems>
      <List Name="ReceiptList">
        <DataSetName>Receipts</DataSetName>
        <Top>0in</Top><Left>0in</Left><Width>7.8in</Width><Height>3.4in</Height>
        <Grouping Name="ReceiptGroup">
          <GroupExpressions><GroupExpression>=Fields!ReceiptNumber.Value</GroupExpression></GroupExpressions>
          <PageBreakAtEnd>true</PageBreakAtEnd>
        </Grouping>
        <ReportItems>
        <Rectangle Name="ReceiptBox"><Top>0in</Top><Left>0in</Left><Width>7.8in</Width><Height>3.35in</Height><ReportItems><Textbox Name="Title"><Top>0.1in</Top><Left>3.3in</Left><Width>4.35in</Width><Height>0.22in</Height><Value>OFFICIAL RECEIPT FOR INCOME TAX PURPOSES</Value><Style><FontFamily>Arial</FontFamily><FontSize>10.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign></Style></Textbox>
          <Image Name="Logo"><Top>.15in</Top><Left>.15in</Left><Width>2.3in</Width><Height>.45in</Height><Source>Embedded</Source><Value>CharityLogo</Value><Sizing>FitProportional</Sizing></Image>
          <Textbox Name="CharityAddress"><Top>0.85in</Top><Left>0.15in</Left><Width>3.6in</Width><Height>0.65in</Height><Value>=First(Fields!CharityName.Value, "Charity") &amp; Chr(10) &amp; First(Fields!CharityAddress.Value, "Charity")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize></Style></Textbox>
          <Textbox Name="DonorAddress"><Top>1.8in</Top><Left>0.15in</Left><Width>3.6in</Width><Height>0.65in</Height><Value>=Fields!DonorName.Value &amp; Chr(10) &amp; Fields!DonorAddress.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize></Style></Textbox>
          <Textbox Name="R0Label"><Top>0.8in</Top><Left>4.5in</Left><Width>1.9in</Width><Height>0.18in</Height><Value>Receipt No.:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Right</TextAlign><Color>#333333</Color></Style></Textbox>
          <Textbox Name="R0Value"><Top>0.8in</Top><Left>6.45in</Left><Width>1.3in</Width><Height>0.18in</Height><Value>=Fields!ReceiptNumber.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize></Style></Textbox>
          <Textbox Name="R1Label"><Top>0.99in</Top><Left>4.5in</Left><Width>1.9in</Width><Height>0.18in</Height><Value>Gift date:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Right</TextAlign><Color>#333333</Color></Style></Textbox>
          <Textbox Name="R1Value"><Top>0.99in</Top><Left>6.45in</Left><Width>1.3in</Width><Height>0.18in</Height><Value>=Format(CDate(Fields!GiftDate.Value), "MMMM d, yyyy")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize></Style></Textbox>
          <Textbox Name="R2Label"><Top>1.18in</Top><Left>4.5in</Left><Width>1.9in</Width><Height>0.18in</Height><Value>Date issued:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Right</TextAlign><Color>#333333</Color></Style></Textbox>
          <Textbox Name="R2Value"><Top>1.18in</Top><Left>6.45in</Left><Width>1.3in</Width><Height>0.18in</Height><Value>=Format(CDate(Fields!DateIssued.Value), "MMMM d, yyyy")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize></Style></Textbox>
          <Textbox Name="R3Label"><Top>1.37in</Top><Left>4.5in</Left><Width>1.9in</Width><Height>0.18in</Height><Value>Gift amount:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Right</TextAlign><Color>#333333</Color></Style></Textbox>
          <Textbox Name="R3Value"><Top>1.37in</Top><Left>6.45in</Left><Width>1.3in</Width><Height>0.18in</Height><Value>=Format(Fields!GiftAmount.Value, "$#,##0.00") &amp; " " &amp; First(Fields!Currency.Value, "Charity")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize></Style></Textbox>
          <Textbox Name="R4Label"><Top>1.56in</Top><Left>4.5in</Left><Width>1.9in</Width><Height>0.18in</Height><Value>Benefit:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Right</TextAlign><Color>#333333</Color></Style></Textbox>
          <Textbox Name="R4Value"><Top>1.56in</Top><Left>6.45in</Left><Width>1.3in</Width><Height>0.18in</Height><Value>=Format(Fields!BenefitAmount.Value, "$#,##0.00") &amp; " " &amp; First(Fields!Currency.Value, "Charity")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize></Style></Textbox>
          <Textbox Name="R5Label"><Top>1.75in</Top><Left>4.5in</Left><Width>1.9in</Width><Height>0.18in</Height><Value>Eligible amount:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Right</TextAlign><Color>#333333</Color></Style></Textbox>
          <Textbox Name="R5Value"><Top>1.75in</Top><Left>6.45in</Left><Width>1.3in</Width><Height>0.18in</Height><Value>=Format(Fields!GiftAmount.Value - Fields!BenefitAmount.Value, "$#,##0.00") &amp; " " &amp; First(Fields!Currency.Value, "Charity")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize></Style></Textbox>
          <Textbox Name="R6Label"><Top>1.94in</Top><Left>4.5in</Left><Width>1.9in</Width><Height>0.18in</Height><Value>Location issued:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Right</TextAlign><Color>#333333</Color></Style></Textbox>
          <Textbox Name="R6Value"><Top>1.94in</Top><Left>6.45in</Left><Width>1.3in</Width><Height>0.18in</Height><Value>=First(Fields!LocationIssued.Value, "Charity")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize></Style></Textbox>
          <Image Name="Signature"><Top>2.2in</Top><Left>5.4in</Left><Width>1.9in</Width><Height>.48in</Height><Source>Embedded</Source><Value>Signature</Value><Sizing>FitProportional</Sizing></Image>
          <Line Name="SignatureLine"><Top>2.72in</Top><Left>5.15in</Left><Width>2.45in</Width><Height>0in</Height><Style><BorderStyle><Default>Solid</Default></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth></Style></Line>
          <Textbox Name="SignerName"><Top>2.78in</Top><Left>5.15in</Left><Width>2.45in</Width><Height>0.16in</Height><Value>=First(Fields!SignerName.Value, "Charity")</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Center</TextAlign></Style></Textbox>
          <Textbox Name="ThankYou"><Top>3.0in</Top><Left>5.15in</Left><Width>2.45in</Width><Height>0.18in</Height><Value>=First(Fields!ThankYou.Value, "Charity")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign></Style></Textbox>
          <Textbox Name="RegNo"><Top>2.95in</Top><Left>0.15in</Left><Width>3.6in</Width><Height>0.15in</Height><Value>="Charitable Registration No.: " &amp; First(Fields!RegistrationNumber.Value, "Charity")</Value><Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize></Style></Textbox>
          <Textbox Name="Website"><Top>3.08in</Top><Left>0.15in</Left><Width>3.6in</Width><Height>0.15in</Height><Value>=First(Fields!Website.Value, "Charity")</Value><Action><Hyperlink>="https://" &amp; First(Fields!Website.Value, "Charity")</Hyperlink></Action><Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize></Style></Textbox></ReportItems><Style><BorderStyle><Default>Solid</Default></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth></Style></Rectangle>
        </ReportItems>
      </List>
    </ReportItems>
  </Body>
</Report>
