      <Rectangle Name="TotalsBox"><Top>3.5in</Top><Left>0in</Left><Width>10.4in</Width><Height>1.2in</Height><ReportItems><Textbox Name="Tot0Label"><Top>0.08in</Top><Left>4.5in</Left><Width>4.6in</Width><Height>0.15in</Height><Value>Sales Amount</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign></Style></Textbox><Textbox Name="Tot0Value"><Top>0.08in</Top><Left>9.3in</Left><Width>0.95in</Width><Height>0.15in</Height><Value>=Format(Sum(Fields!Ordered.Value * Fields!UnitPrice.Value, "Lines"), "0.00")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign></Style></Textbox><Textbox Name="Tot1Label"><Top>0.23in</Top><Left>4.5in</Left><Width>4.6in</Width><Height>0.15in</Height><Value>Total Sales and Estimated Tariff Amount</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign></Style></Textbox><Textbox Name="Tot1Value"><Top>0.23in</Top><Left>9.3in</Left><Width>0.95in</Width><Height>0.15in</Height><Value>=Format((Sum(Fields!Ordered.Value * Fields!UnitPrice.Value, "Lines") + First(Fields!EstimatedTariff.Value, "Header")), "0.00")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign></Style></Textbox><Textbox Name="Tot2Label"><Top>0.38in</Top><Left>4.5in</Left><Width>4.6in</Width><Height>0.15in</Height><Value>Shipping charges applied</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign></Style></Textbox><Textbox Name="Tot2Value"><Top>0.38in</Top><Left>9.3in</Left><Width>0.95in</Width><Height>0.15in</Height><Value>=Format(First(Fields!ShippingCharges.Value, "Header"), "0.00")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign></Style></Textbox><Textbox Name="Tot3Label"><Top>0.53in</Top><Left>4.5in</Left><Width>4.6in</Width><Height>0.15in</Height><Value>=First(Fields!TaxLabel.Value, "Header")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign></Style></Textbox><Textbox Name="Tot3Value"><Top>0.53in</Top><Left>9.3in</Left><Width>0.95in</Width><Height>0.15in</Height><Value>=Format(Round(((Sum(Fields!Ordered.Value * Fields!UnitPrice.Value, "Lines") + First(Fields!EstimatedTariff.Value, "Header")) + First(Fields!ShippingCharges.Value, "Header")) * First(Fields!TaxRate.Value, "Header"), 2), "0.00")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign></Style></Textbox><Textbox Name="Tot4Label"><Top>0.68in</Top><Left>4.5in</Left><Width>4.6in</Width><Height>0.15in</Height><Value>Total</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign></Style></Textbox><Textbox Name="Tot4Value"><Top>0.68in</Top><Left>9.3in</Left><Width>0.95in</Width><Height>0.15in</Height><Value>=Format(((Sum(Fields!Ordered.Value * Fields!UnitPrice.Value, "Lines") + First(Fields!EstimatedTariff.Value, "Header")) + First(Fields!ShippingCharges.Value, "Header") + Round(((Sum(Fields!Ordered.Value * Fields!UnitPrice.Value, "Lines") + First(Fields!EstimatedTariff.Value, "Header")) + First(Fields!ShippingCharges.Value, "Header")) * First(Fields!TaxRate.Value, "Header"), 2)), "0.00")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign></Style></Textbox><Textbox Name="Tot5Label"><Top>0.83in</Top><Left>4.5in</Left><Width>4.6in</Width><Height>0.15in</Height><Value></Value><Style><FontFamily>Courier New</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign></Style></Textbox><Textbox Name="Tot5Value"><Top>0.83in</Top><Left>9.3in</Left><Width>0.95in</Width><Height>0.15in</Height><Value>=First(Fields!Currency.Value, "Header")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign></Style></Textbox><Textbox Name="Incoterm"><Top>0.98in</Top><Left>3.5in</Left><Width>6.75in</Width><Height>0.15in</Height><Value>=First(Fields!Incoterm.Value, "Header")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8pt</FontSize><TextAlign>Right</TextAlign></Style></Textbox></ReportItems><Style><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#000000</Default></BorderColor><BorderWidth><Default>1pt</Default></BorderWidth></Style></Rectangle>
