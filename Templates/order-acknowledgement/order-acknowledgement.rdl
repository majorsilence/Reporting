<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Sales order acknowledgement -- bill/ship/buyer/ship-from boxes, order details, a multi-line item table with backorder quantities, and tax/shipping totals.</Description>
  <PageHeight>8.5in</PageHeight>
  <PageWidth>11in</PageWidth>
  <TopMargin>.3in</TopMargin>
  <LeftMargin>.3in</LeftMargin>
  <RightMargin>.3in</RightMargin>
  <BottomMargin>.3in</BottomMargin>
  <Width>10.4in</Width>

  <EmbeddedImages>
    <EmbeddedImage Name="CompanyLogo">
      <MIMEType>image/png</MIMEType>
      <ImageData></ImageData>
    </EmbeddedImage>
  </EmbeddedImages>

  <DataSources>
    <DataSource Name="DS1">
      <ConnectionProperties>
        <DataProvider>Json</DataProvider>
        <ConnectString>file=sample-data.json</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="Header">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>columns=AckNumber,Currency,VendorName,VendorAddress,VendorWebsite,BillTo,ShipTo,Buyer,ShipFrom,CustomerNumber,PaymentTerms,ShippingMethod,OrderSource,OrderDate,EstimatedRelease,EstimatedTariff,ShippingCharges,TaxLabel,TaxRate,Incoterm,WebOrderId,TermsText,TermsLinkText,TermsUrl;table=root</CommandText>
      </Query>
      <Fields>
        <Field Name="AckNumber"><DataField>AckNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Currency"><DataField>Currency</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="VendorName"><DataField>VendorName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="VendorAddress"><DataField>VendorAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="VendorWebsite"><DataField>VendorWebsite</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="BillTo"><DataField>BillTo</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ShipTo"><DataField>ShipTo</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Buyer"><DataField>Buyer</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ShipFrom"><DataField>ShipFrom</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CustomerNumber"><DataField>CustomerNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PaymentTerms"><DataField>PaymentTerms</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ShippingMethod"><DataField>ShippingMethod</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="OrderSource"><DataField>OrderSource</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="OrderDate"><DataField>OrderDate</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="EstimatedRelease"><DataField>EstimatedRelease</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="EstimatedTariff"><DataField>EstimatedTariff</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
        <Field Name="ShippingCharges"><DataField>ShippingCharges</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
        <Field Name="TaxLabel"><DataField>TaxLabel</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="TaxRate"><DataField>TaxRate</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
        <Field Name="Incoterm"><DataField>Incoterm</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="WebOrderId"><DataField>WebOrderId</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="TermsText"><DataField>TermsText</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="TermsLinkText"><DataField>TermsLinkText</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="TermsUrl"><DataField>TermsUrl</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="Lines">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>columns=LineNumber,Ordered,Available,Backordered,PartNumber,Manufacturer,MfgPartNumber,Description,Eccn,Htsus,Notes,UnitPrice;table=root_Lines</CommandText>
      </Query>
      <Fields>
        <Field Name="LineNumber"><DataField>LineNumber</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="Ordered"><DataField>Ordered</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
        <Field Name="Available"><DataField>Available</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
        <Field Name="Backordered"><DataField>Backordered</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
        <Field Name="PartNumber"><DataField>PartNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Manufacturer"><DataField>Manufacturer</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="MfgPartNumber"><DataField>MfgPartNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Description"><DataField>Description</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Eccn"><DataField>Eccn</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Htsus"><DataField>Htsus</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Notes"><DataField>Notes</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="UnitPrice"><DataField>UnitPrice</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>

  <PageHeader>
    <Height>.85in</Height>
    <PrintOnFirstPage>true</PrintOnFirstPage>
    <PrintOnLastPage>true</PrintOnLastPage>
    <ReportItems>
      <Image Name="Logo"><Top>.03in</Top><Left>0in</Left><Width>1.86in</Width><Height>.4in</Height><Source>Embedded</Source><Value>CompanyLogo</Value><Sizing>FitProportional</Sizing></Image><Textbox Name="VendorAddress"><Top>0in</Top><Left>2.0in</Left><Width>2.3in</Width><Height>0.62in</Height><Value>=First(Fields!VendorAddress.Value, "Header")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox><Textbox Name="Website"><Top>0in</Top><Left>4.4in</Left><Width>1.6in</Width><Height>0.15in</Height><Value>=First(Fields!VendorWebsite.Value, "Header")</Value><Action><Hyperlink>="https://" &amp; First(Fields!VendorWebsite.Value, "Header")</Hyperlink></Action><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><Color>Blue</Color><TextDecoration>Underline</TextDecoration></Style></Textbox><Textbox Name="AckTitle"><Top>0in</Top><Left>6.4in</Left><Width>4.0in</Width><Height>0.22in</Height><Value>="PO Acknowledgement " &amp; First(Fields!AckNumber.Value, "Header")</Value><Style><FontFamily>Arial</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign></Style></Textbox><Textbox Name="AckCurrency"><Top>0.2in</Top><Left>6.4in</Left><Width>4.0in</Width><Height>0.2in</Height><Value>=First(Fields!Currency.Value, "Header")</Value><Style><FontFamily>Arial</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign></Style></Textbox>
    </ReportItems>
  </PageHeader>

  <Body>
    <Height>5.0in</Height>
    <ReportItems>
      <Textbox Name="BillToLabel"><Top>0in</Top><Left>0in</Left><Width>0.18in</Width><Height>0.95in</Height><Value>Bill To:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign><WritingMode>tb-lr</WritingMode><VerticalAlign>Top</VerticalAlign><TextDecoration>Underline</TextDecoration></Style></Textbox><Textbox Name="BillToValue"><Top>0in</Top><Left>0.18in</Left><Width>3.42in</Width><Height>0.95in</Height><Value>=First(Fields!BillTo.Value, "Header")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>9pt</FontSize><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#000000</Default></BorderColor><BorderWidth><Default>1pt</Default></BorderWidth><PaddingLeft>3pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox>
      <Textbox Name="ShipToLabel"><Top>0in</Top><Left>3.7in</Left><Width>0.18in</Width><Height>0.95in</Height><Value>Ship To:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign><WritingMode>tb-lr</WritingMode><VerticalAlign>Top</VerticalAlign><TextDecoration>Underline</TextDecoration></Style></Textbox><Textbox Name="ShipToValue"><Top>0in</Top><Left>3.8800000000000003in</Left><Width>3.42in</Width><Height>0.95in</Height><Value>=First(Fields!ShipTo.Value, "Header")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>9pt</FontSize><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#000000</Default></BorderColor><BorderWidth><Default>1pt</Default></BorderWidth><PaddingLeft>3pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox>
      <Textbox Name="BuyerLabel"><Top>1.05in</Top><Left>0in</Left><Width>0.18in</Width><Height>0.95in</Height><Value>Buyer:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign><WritingMode>tb-lr</WritingMode><VerticalAlign>Top</VerticalAlign><TextDecoration>Underline</TextDecoration></Style></Textbox><Textbox Name="BuyerValue"><Top>1.05in</Top><Left>0.18in</Left><Width>3.42in</Width><Height>0.95in</Height><Value>=First(Fields!Buyer.Value, "Header")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>9pt</FontSize><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#000000</Default></BorderColor><BorderWidth><Default>1pt</Default></BorderWidth><PaddingLeft>3pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox>
      <Textbox Name="ShipFromLabel"><Top>1.05in</Top><Left>3.7in</Left><Width>0.18in</Width><Height>0.95in</Height><Value>Ship From:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign><WritingMode>tb-lr</WritingMode><VerticalAlign>Top</VerticalAlign><TextDecoration>Underline</TextDecoration></Style></Textbox><Textbox Name="ShipFromValue"><Top>1.05in</Top><Left>3.8800000000000003in</Left><Width>3.42in</Width><Height>0.95in</Height><Value>=First(Fields!ShipFrom.Value, "Header")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>9pt</FontSize><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#000000</Default></BorderColor><BorderWidth><Default>1pt</Default></BorderWidth><PaddingLeft>3pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox>
      <Textbox Name="InfoCustomerNumberLabel"><Top>0.03in</Top><Left>7.4in</Left><Width>1.45in</Width><Height>0.15in</Height><Value>Customer:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox>
      <Textbox Name="InfoCustomerNumberValue"><Top>0.03in</Top><Left>8.85in</Left><Width>1.55in</Width><Height>0.15in</Height><Value>=First(Fields!CustomerNumber.Value, "Header")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8.5pt</FontSize></Style></Textbox>
      <Textbox Name="InfoPaymentTermsLabel"><Top>0.18in</Top><Left>7.4in</Left><Width>1.45in</Width><Height>0.15in</Height><Value>Payment Terms:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox>
      <Textbox Name="InfoPaymentTermsValue"><Top>0.18in</Top><Left>8.85in</Left><Width>1.55in</Width><Height>0.15in</Height><Value>=First(Fields!PaymentTerms.Value, "Header")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8.5pt</FontSize></Style></Textbox>
      <Textbox Name="InfoShippingMethodLabel"><Top>0.33in</Top><Left>7.4in</Left><Width>1.45in</Width><Height>0.15in</Height><Value>Shipping Method:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox>
      <Textbox Name="InfoShippingMethodValue"><Top>0.33in</Top><Left>8.85in</Left><Width>1.55in</Width><Height>0.15in</Height><Value>=First(Fields!ShippingMethod.Value, "Header")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8.5pt</FontSize></Style></Textbox>
      <Textbox Name="InfoOrderSourceLabel"><Top>0.48in</Top><Left>7.4in</Left><Width>1.45in</Width><Height>0.15in</Height><Value>Order Source:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox>
      <Textbox Name="InfoOrderSourceValue"><Top>0.48in</Top><Left>8.85in</Left><Width>1.55in</Width><Height>0.15in</Height><Value>=First(Fields!OrderSource.Value, "Header")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8.5pt</FontSize></Style></Textbox>
      <Textbox Name="InfoOrderDateLabel"><Top>0.63in</Top><Left>7.4in</Left><Width>1.45in</Width><Height>0.15in</Height><Value>Order Date:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox>
      <Textbox Name="InfoOrderDateValue"><Top>0.63in</Top><Left>8.85in</Left><Width>1.55in</Width><Height>0.15in</Height><Value>=First(Fields!OrderDate.Value, "Header")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8.5pt</FontSize></Style></Textbox>
      <Textbox Name="InfoEstimatedReleaseLabel"><Top>0.78in</Top><Left>7.4in</Left><Width>1.45in</Width><Height>0.15in</Height><Value>Estimated Release Date:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox>
      <Textbox Name="InfoEstimatedReleaseValue"><Top>0.78in</Top><Left>8.85in</Left><Width>1.55in</Width><Height>0.15in</Height><Value>=First(Fields!EstimatedRelease.Value, "Header")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>8.5pt</FontSize></Style></Textbox>
      <Table Name="LinesTable"><DataSetName>Lines</DataSetName><NoRows>No line items.</NoRows><Top>2.2in</Top><Left>0in</Left><Style><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#000000</Default></BorderColor><BorderWidth><Default>1pt</Default></BorderWidth></Style><TableColumns><TableColumn><Width>0.4in</Width></TableColumn><TableColumn><Width>0.75in</Width></TableColumn><TableColumn><Width>0.75in</Width></TableColumn><TableColumn><Width>0.75in</Width></TableColumn><TableColumn><Width>6.25in</Width></TableColumn><TableColumn><Width>0.75in</Width></TableColumn><TableColumn><Width>0.75in</Width></TableColumn></TableColumns><Header><TableRows><TableRow><Height>.32in</Height><TableCells><TableCell><ReportItems><Textbox Name="H_LineNumber"><Value>Line
