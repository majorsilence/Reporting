umber.Value</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Center</TextAlign><BorderStyle><Left>Solid</Left><Right>Solid</Right></BorderStyle><BorderColor><Default>#000000</Default></BorderColor><BorderWidth><Default>1pt</Default></BorderWidth><PaddingTop>4pt</PaddingTop><PaddingRight>4pt</PaddingRight><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#EFEFEF", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="D_Ordered"><Value>=Fields!Ordered.Value</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Center</TextAlign><BorderStyle><Left>Solid</Left><Right>Solid</Right></BorderStyle><BorderColor><Default>#000000</Default></BorderColor><BorderWidth><Default>1pt</Default></BorderWidth><PaddingTop>4pt</PaddingTop><PaddingRight>4pt</PaddingRight><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#EFEFEF", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="D_Available"><Value>=Fields!Available.Value</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Center</TextAlign><BorderStyle><Left>Solid</Left><Right>Solid</Right></BorderStyle><BorderColor><Default>#000000</Default></BorderColor><BorderWidth><Default>1pt</Default></BorderWidth><PaddingTop>4pt</PaddingTop><PaddingRight>4pt</PaddingRight><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#EFEFEF", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="D_Backordered"><Value>=Fields!Backordered.Value</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Center</TextAlign><BorderStyle><Left>Solid</Left><Right>Solid</Right></BorderStyle><BorderColor><Default>#000000</Default></BorderColor><BorderWidth><Default>1pt</Default></BorderWidth><PaddingTop>4pt</PaddingTop><PaddingRight>4pt</PaddingRight><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#EFEFEF", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Rectangle Name="D_ItemRect"><ReportItems><Textbox Name="D_PartLabel"><Top>0.03in</Top><Left>0.03in</Left><Width>0.45in</Width><Height>0.15in</Height><Value>PART:</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox><Textbox Name="D_Part"><Top>0.03in</Top><Left>0.45in</Left><Width>2.6in</Width><Height>0.15in</Height><Value>=Fields!PartNumber.Value</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox><Textbox Name="D_DescLabel"><Top>0.03in</Top><Left>3.3in</Left><Width>0.45in</Width><Height>0.15in</Height><Value>DESC:</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox><Textbox Name="D_Desc"><Top>0.03in</Top><Left>3.72in</Left><Width>2.5in</Width><Height>0.15in</Height><CanGrow>true</CanGrow><Value>=Fields!Description.Value</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox><Textbox Name="D_MfgLabel"><Top>0.18in</Top><Left>0.03in</Left><Width>0.45in</Width><Height>0.15in</Height><Value>MFG :</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox><Textbox Name="D_Mfg"><Top>0.18in</Top><Left>0.45in</Left><Width>2.8in</Width><Height>0.15in</Height><Value>=Fields!Manufacturer.Value &amp; " / " &amp; Fields!MfgPartNumber.Value</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox><Textbox Name="D_EccnLabel"><Top>0.33in</Top><Left>0.03in</Left><Width>0.45in</Width><Height>0.15in</Height><Value>ECCN:</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox><Textbox Name="D_Eccn"><Top>0.33in</Top><Left>0.45in</Left><Width>1.0in</Width><Height>0.15in</Height><Value>=Fields!Eccn.Value</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox><Textbox Name="D_HtsusLabel"><Top>0.33in</Top><Left>1.6in</Left><Width>0.55in</Width><Height>0.15in</Height><Value>HTSUS:</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></Textbox><Textbox Name="D_Htsus"><Top>0.33in</Top><Left>2.12in</Left><Width>1.1in</Width><Height>0.15in</Height><Value>=Fields!Htsus.Value</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox><Textbox Name="D_Notes"><Top>0.48in</Top><Left>0.03in</Left><Width>3.2in</Width><Height>0.15in</Height><CanGrow>true</CanGrow><Value>=Fields!Notes.Value</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize></Style></Textbox></ReportItems><Style><BorderStyle><Left>Solid</Left><Right>Solid</Right></BorderStyle><BorderColor><Default>#000000</Default></BorderColor><BorderWidth><Default>1pt</Default></BorderWidth><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#EFEFEF", "White")</BackgroundColor></Style></Rectangle></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="D_UnitPrice"><Value>=Format(Fields!UnitPrice.Value, "0.00000")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Right</TextAlign><BorderStyle><Left>Solid</Left><Right>Solid</Right></BorderStyle><BorderColor><Default>#000000</Default></BorderColor><BorderWidth><Default>1pt</Default></BorderWidth><PaddingTop>4pt</PaddingTop><PaddingRight>4pt</PaddingRight><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#EFEFEF", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="D_Amount"><Value>=Format(Fields!Ordered.Value * Fields!UnitPrice.Value, "0.00")</Value><Style><FontFamily>Courier New</FontFamily><FontSize>7.5pt</FontSize><TextAlign>Right</TextAlign><BorderStyle><Left>Solid</Left><Right>Solid</Right></BorderStyle><BorderColor><Default>#000000</Default></BorderColor><BorderWidth><Default>1pt</Default></BorderWidth><PaddingTop>4pt</PaddingTop><PaddingRight>4pt</PaddingRight><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#EFEFEF", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell></TableCells></TableRow></TableRows></Details><Footer><TableRows><TableRow><Height>.02in</Height><TableCells><TableCell><ReportItems><Textbox Name="F_LineNumber"><Value></Value><Style><BorderStyle><Top>Solid</Top></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth><FontSize>1pt</FontSize></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="F_Ordered"><Value></Value><Style><BorderStyle><Top>Solid</Top></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth><FontSize>1pt</FontSize></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="F_Available"><Value></Value><Style><BorderStyle><Top>Solid</Top></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth><FontSize>1pt</FontSize></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="F_Backordered"><Value></Value><Style><BorderStyle><Top>Solid</Top></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth><FontSize>1pt</FontSize></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="F_Item"><Value></Value><Style><BorderStyle><Top>Solid</Top></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth><FontSize>1pt</FontSize></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="F_UnitPrice"><Value></Value><Style><BorderStyle><Top>Solid</Top></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth><FontSize>1pt</FontSize></Style></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="F_Amount"><Value></Value><Style><BorderStyle><Top>Solid</Top></BorderStyle><BorderWidth><Default>1pt</Default></BorderWidth><Fo