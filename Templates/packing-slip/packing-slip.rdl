<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Packing slip -- order/ship-to header, carrier and tracking info, and an itemized shipment table that flags short-shipped lines.</Description>
  <PageHeight>11in</PageHeight>
  <PageWidth>8.5in</PageWidth>
  <TopMargin>.5in</TopMargin>
  <LeftMargin>.6in</LeftMargin>
  <RightMargin>.6in</RightMargin>
  <BottomMargin>.5in</BottomMargin>
  <Width>7.3in</Width>

  <DataSources>
    <DataSource Name="DS1">
      <ConnectionProperties>
        <DataProvider>Json</DataProvider>
        <ConnectString>file=sample-data.json</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="Header">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>columns=OrderNumber,OrderDate,ShipDate,ShippedFrom,ShipToName,ShipToAddress,CarrierName,TrackingNumber,Notes;table=root</CommandText>
      </Query>
      <Fields>
        <Field Name="OrderNumber"><DataField>OrderNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="OrderDate"><DataField>OrderDate</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ShipDate"><DataField>ShipDate</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ShippedFrom"><DataField>ShippedFrom</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ShipToName"><DataField>ShipToName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ShipToAddress"><DataField>ShipToAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CarrierName"><DataField>CarrierName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="TrackingNumber"><DataField>TrackingNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Notes"><DataField>Notes</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="Items">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>columns=Sku,Description,QuantityOrdered,QuantityShipped;table=root_Items</CommandText>
      </Query>
      <Fields>
        <Field Name="Sku"><DataField>Sku</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Description"><DataField>Description</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="QuantityOrdered"><DataField>QuantityOrdered</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
        <Field Name="QuantityShipped"><DataField>QuantityShipped</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>

  <Body>
    <Height>9in</Height>
    <ReportItems>
      <Textbox Name="Title">
        <Top>0in</Top><Left>0in</Left><Width>4in</Width><Height>.28in</Height>
        <Value>PACKING SLIP</Value>
        <Style><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><Color>#2C3E50</Color></Style>
      </Textbox>
      <Textbox Name="ShippedFrom">
        <Top>.34in</Top><Left>0in</Left><Width>4in</Width><Height>.3in</Height>
        <CanGrow>true</CanGrow>
        <Value>=First(Fields!ShippedFrom.Value, "Header")</Value>
        <Style><FontSize>9pt</FontSize><Color>Gray</Color></Style>
      </Textbox>

      <Textbox Name="OrderNumberLabel">
        <Top>0in</Top><Left>4.8in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>Order #</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign><Color>Gray</Color></Style>
      </Textbox>
      <Textbox Name="OrderNumberValue">
        <Top>0in</Top><Left>6.1in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>=First(Fields!OrderNumber.Value, "Header")</Value>
        <Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign></Style>
      </Textbox>
      <Textbox Name="OrderDateLabel">
        <Top>.2in</Top><Left>4.8in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>Order date</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign><Color>Gray</Color></Style>
      </Textbox>
      <Textbox Name="OrderDateValue">
        <Top>.2in</Top><Left>6.1in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>=First(Fields!OrderDate.Value, "Header")</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign></Style>
      </Textbox>
      <Textbox Name="ShipDateLabel">
        <Top>.4in</Top><Left>4.8in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>Ship date</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign><Color>Gray</Color></Style>
      </Textbox>
      <Textbox Name="ShipDateValue">
        <Top>.4in</Top><Left>6.1in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>=First(Fields!ShipDate.Value, "Header")</Value>
        <Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign></Style>
      </Textbox>

      <Textbox Name="ShipToLabel">
        <Top>.85in</Top><Left>0in</Left><Width>3in</Width><Height>.18in</Height>
        <Value>Ship To</Value>
        <Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>Gray</Color></Style>
      </Textbox>
      <Textbox Name="ShipToName">
        <Top>1.05in</Top><Left>0in</Left><Width>3.5in</Width><Height>.2in</Height>
        <Value>=First(Fields!ShipToName.Value, "Header")</Value>
        <Style><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight></Style>
      </Textbox>
      <Textbox Name="ShipToAddress">
        <Top>1.27in</Top><Left>0in</Left><Width>3.5in</Width><Height>.4in</Height>
        <CanGrow>true</CanGrow>
        <Value>=First(Fields!ShipToAddress.Value, "Header")</Value>
        <Style><FontSize>9pt</FontSize></Style>
      </Textbox>

      <Textbox Name="CarrierLabel">
        <Top>.85in</Top><Left>4.8in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>Carrier</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign><Color>Gray</Color></Style>
      </Textbox>
      <Textbox Name="CarrierValue">
        <Top>.85in</Top><Left>6.1in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>=First(Fields!CarrierName.Value, "Header")</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign></Style>
      </Textbox>
      <Textbox Name="TrackingLabel">
        <Top>1.05in</Top><Left>4.8in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>Tracking #</Value>
        <Style><FontSize>9pt</FontSize><TextAlign>Right</TextAlign><Color>Gray</Color></Style>
      </Textbox>
      <Textbox Name="TrackingValue">
        <Top>1.05in</Top><Left>6.1in</Left><Width>1.2in</Width><Height>.18in</Height>
        <Value>=First(Fields!TrackingNumber.Value, "Header")</Value>
        <Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign></Style>
      </Textbox>

      <Table Name="ItemsTable">
        <DataSetName>Items</DataSetName>
        <NoRows>No items on this shipment.</NoRows>
        <Top>2.1in</Top>
        <Left>0in</Left>
        <TableColumns>
          <TableColumn><Width>1in</Width></TableColumn>
          <TableColumn><Width>3.3in</Width></TableColumn>
          <TableColumn><Width>1.15in</Width></TableColumn>
          <TableColumn><Width>1.15in</Width></TableColumn>
          <TableColumn><Width>.7in</Width></TableColumn>
        </TableColumns>
        <Header>
          <TableRows>
            <TableRow>
              <Height>.22in</Height>
              <TableCells>
                <TableCell><ReportItems><Textbox Name="H_Sku"><Value>SKU</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2C3E50</BackgroundColor><Color>White</Color><PaddingLeft>4pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="H_Desc"><Value>Description</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2C3E50</BackgroundColor><Color>White</Color><PaddingLeft>4pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="H_Ord"><Value>Ordered</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2C3E50</BackgroundColor><Color>White</Color><TextAlign>Right</TextAlign><PaddingRight>4pt</PaddingRight><VerticalAlign>Middle</VerticalAlign></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="H_Shp"><Value>Shipped</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2C3E50</BackgroundColor><Color>White</Color><TextAlign>Right</TextAlign><PaddingRight>4pt</PaddingRight><VerticalAlign>Middle</VerticalAlign></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="H_St"><Value>Status</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2C3E50</BackgroundColor><Color>White</Color><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></ReportItems></TableCell>
              </TableCells>
            </TableRow>
          </TableRows>
          <RepeatOnNewPage>true</RepeatOnNewPage>
        </Header>
        <Details>
          <TableRows>
            <TableRow>
              <Height>.2in</Height>
              <TableCells>
                <TableCell><ReportItems><Textbox Name="D_Sku"><Value>=Fields!Sku.Value</Value><Style><PaddingLeft>4pt</PaddingLeft><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#F3EEFA", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="D_Desc"><Value>=Fields!Description.Value</Value><CanGrow>true</CanGrow><Style><PaddingLeft>4pt</PaddingLeft><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#F3EEFA", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="D_Ord"><Value>=Fields!QuantityOrdered.Value</Value><Style><TextAlign>Right</TextAlign><PaddingRight>4pt</PaddingRight><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#F3EEFA", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="D_Shp"><Value>=Fields!QuantityShipped.Value</Value><Style><TextAlign>Right</TextAlign><PaddingRight>4pt</PaddingRight><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#F3EEFA", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="D_St"><Value>=IIf(Fields!QuantityShipped.Value &lt; Fields!QuantityOrdered.Value, "BACKORDER", "OK")</Value><Style><TextAlign>Center</TextAlign><FontWeight>Bold</FontWeight><FontSize>8pt</FontSize><Color>=IIf(Fields!QuantityShipped.Value &lt; Fields!QuantityOrdered.Value, "#C0392B", "#1E8449")</Color><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#F3EEFA", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell>
              </TableCells>
            </TableRow>
          </TableRows>
        </Details>
      </Table>

      <Textbox Name="NotesLabel">
        <Top>4in</Top><Left>0in</Left><Width>4in</Width><Height>.18in</Height>
        <Value>Notes</Value>
        <Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>Gray</Color></Style>
      </Textbox>
      <Textbox Name="NotesValue">
        <Top>4.2in</Top><Left>0in</Left><Width>7.3in</Width><Height>.6in</Height>
        <CanGrow>true</CanGrow>
        <Value>=First(Fields!Notes.Value, "Header")</Value>
        <Style><FontSize>9pt</FontSize></Style>
      </Textbox>
    </ReportItems>
  </Body>

  <PageFooter>
    <Height>16pt</Height>
    <PrintOnFirstPage>true</PrintOnFirstPage>
    <PrintOnLastPage>true</PrintOnLastPage>
    <ReportItems>
      <Textbox Name="PageNum">
        <Top>1pt</Top><Left>0in</Left><Width>3in</Width><Height>14pt</Height>
        <Value>=Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value>
        <Style><FontSize>8pt</FontSize><Color>Gray</Color></Style>
      </Textbox>
    </ReportItems>
  </PageFooter>
</Report>
