<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
    <AssemblyTitle>Majorsilence PDF</AssemblyTitle>
    <PackageId>Majorsilence.Pdf</PackageId>
    <Description>Zero-dependency PDF generation library. Writes PDF 1.4 and 2.0 with embedded TrueType fonts, JPEG and raster images, vector graphics, and hyperlink annotations.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>MIT OR Apache-2.0 OR BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>
</Project>
