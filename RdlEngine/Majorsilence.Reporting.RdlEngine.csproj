<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<ProjectType>Local</ProjectType>
		<DelaySign>false</DelaySign>
		<OutputType>Library</OutputType>
		<RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<AssemblyTitle>RDL Engine</AssemblyTitle>
		<DelaySign>false</DelaySign>
		<PackageId>Majorsilence.Reporting.RdlEngine</PackageId>
		<Description>Cross-platform RDL/RDLC report rendering engine — run SQL Server Reporting Services (SSRS 2005) report definitions without a report server on Linux, macOS, Windows, and containers. SkiaSharp-based rendering, Native-AOT-compatible. Renders to PDF, HTML, MHTML, CSV, Excel, and images. Targets .NET 8 and .NET 10.</Description>
		<PackageTags>rdl;rdlc;ssrs;reporting;reports;pdf;crystal-reports-alternative;cross-platform;aot;dotnet</PackageTags>
		<Configurations>Debug;Release</Configurations>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<WarningsAsErrors>4014</WarningsAsErrors>
        <IsPackable>true</IsPackable>
        <Nullable>enable</Nullable>
	</PropertyGroup>
	<!-- AOT/trim analysis. Note: VBCodeProvider (<Code> element), Assembly.Load plug-ins, and custom
	     compression still require dynamic code at runtime; those paths are guarded with
	     [RequiresDynamicCode] / RuntimeFeature.IsDynamicCodeSupported. -->
	<PropertyGroup>
		<IsAotCompatible>true</IsAotCompatible>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	</PropertyGroup>
	<ItemGroup>
		<Reference Update="System">
			<Name>System</Name>
		</Reference>
		<Reference Update="System.Data">
			<Name>System.Data</Name>
		</Reference>
		<Reference Update="System.Xml">
			<Name>System.XML</Name>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<Compile Update="Resources\Strings.Designer.cs">
			<AutoGen>True</AutoGen>
			<DesignTime>True</DesignTime>
			<DependentUpon>Strings.resx</DependentUpon>
		</Compile>
		<Compile Update="Resources\Strings.ru-RU.Designer.cs">
			<AutoGen>True</AutoGen>
			<DesignTime>True</DesignTime>
			<DependentUpon>Strings.ru-RU.resx</DependentUpon>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<None Update="RdlEngineConfig.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\DataProviders\Majorsilence.Reporting.DataProviders.csproj" />
		<ProjectReference Include="..\Majorsilence.Pdf\Majorsilence.Pdf.csproj" />
		<ProjectReference Include="..\Majorsilence.Pdf.Security\Majorsilence.Pdf.Security.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Majorsilence.Forms" />
		<PackageReference Include="Majorsilence.Forms.Drawing.Common" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Update="Resources\Strings.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Strings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Strings.ru-RU.resx">
			<LastGenOutput>Strings.ru-RU.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
	<PropertyGroup />
	<ItemGroup>
		<Compile Update="Resources\Strings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Strings.resx</DependentUpon>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Update="Resources\Strings.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Strings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Strings.ru-RU.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
		</EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="SharpZipLib" />
		<PackageReference Include="SkiaSharp" />

		<PackageReference Include="System.Data.Odbc" />
		<!-- OleDB is COM-based and not AOT-compatible; kept for compilation but throws at AOT runtime -->
		<PackageReference Include="System.Data.OleDb" />
		<!-- CodeDom/VBCodeProvider usage is guarded with RuntimeFeature.IsDynamicCodeSupported -->
		<PackageReference Include="System.CodeDom" />
		<PackageReference Include="System.Security.Cryptography.Xml" />
	</ItemGroup>
	<ItemGroup>
		<!-- The System.Drawing / GDI+ rendering path (replaced by Majorsilence.Forms.Drawing). -->
		<Compile Remove="PageDrawing.cs" />
		<Compile Remove="RdlPrint.cs" />
		<Compile Remove="Definition\EMFConverter\**\**\*.cs" />
	</ItemGroup>
</Project>
