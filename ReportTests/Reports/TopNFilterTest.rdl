<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Table filtered to the top 3 rows by Amount: regression workload for the Top N filter sort.</Description>
  <Width>6in</Width><PageWidth>8.5in</PageWidth><PageHeight>11in</PageHeight>
  <TopMargin>.5in</TopMargin><BottomMargin>.5in</BottomMargin><LeftMargin>.5in</LeftMargin><RightMargin>.5in</RightMargin>
  <DataSources><DataSource Name="DS1"><ConnectionProperties><DataProvider>xxx</DataProvider><ConnectString>none</ConnectString></ConnectionProperties></DataSource></DataSources>
  <DataSets>
    <DataSet Name="Data">
      <Query><DataSourceName>DS1</DataSourceName><CommandText></CommandText></Query>
      <Fields>
        <Field Name="Id"><DataField>Id</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="Amount"><DataField>Amount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
      </Fields>
      <fyi:Rows xmlns:fyi="http://www.fyireporting.com/schemas">
        <Row><Id>1</Id><Amount>10</Amount></Row>
        <Row><Id>2</Id><Amount>50</Amount></Row>
        <Row><Id>3</Id><Amount>30</Amount></Row>
        <Row><Id>4</Id><Amount>20</Amount></Row>
        <Row><Id>5</Id><Amount>5</Amount></Row>
        <Row><Id>6</Id><Amount>1</Amount></Row>
        <Row><Id>7</Id><Amount>40</Amount></Row>
        <Row><Id>8</Id><Amount>25</Amount></Row>
        <Row><Id>9</Id><Amount>99</Amount></Row>
        <Row><Id>10</Id><Amount>1</Amount></Row>
      </fyi:Rows>
    </DataSet>
  </DataSets>
  <Body>
    <Height>1in</Height>
    <ReportItems>
      <Table Name="Table1">
        <DataSetName>Data</DataSetName>
        <Top>0in</Top><Left>0in</Left><Width>6in</Width><Height>0.2in</Height>
        <TableColumns><TableColumn><Width>3in</Width></TableColumn><TableColumn><Width>3in</Width></TableColumn></TableColumns>
        <Filters>
          <Filter>
            <FilterExpression>=Fields!Amount.Value</FilterExpression>
            <Operator>TopN</Operator>
            <FilterValues><FilterValue>3</FilterValue></FilterValues>
          </Filter>
        </Filters>
        <Details><TableRows><TableRow><Height>0.2in</Height><TableCells>
          <TableCell><ReportItems><Textbox Name="dId"><Value>=Fields!Id.Value</Value></Textbox></ReportItems></TableCell><TableCell><ReportItems><Textbox Name="dAmt"><Value>=Fields!Amount.Value</Value></Textbox></ReportItems></TableCell>
        </TableCells></TableRow></TableRows></Details>
      </Table>
    </ReportItems>
  </Body>
</Report>
