<?xml version="1.0" encoding="UTF-8"?>
<Report Name="RunningValueScopeTest">
  <Description>Reproduces issue #144: RunningValue with an explicit group scope.</Description>
  <DataSources>
    <DataSource Name="DS1">
      <ConnectionProperties>
        <DataProvider>SQLite</DataProvider>
        <ConnectString>Data Source=northwindEF.db;Version=3;</ConnectString>
        <IntegratedSecurity>false</IntegratedSecurity>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Data">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>SELECT CustomerID, Freight FROM Orders ORDER BY CustomerID</CommandText>
      </Query>
      <Fields>
        <Field Name="CustomerID">
          <DataField>CustomerID</DataField>
        </Field>
        <Field Name="Freight">
          <DataField>Freight</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <Body>
    <Height>2in</Height>
    <ReportItems>
      <Table Name="Table1">
        <DataSetName>Data</DataSetName>
        <Top>0in</Top>
        <Left>0in</Left>
        <Height>1in</Height>
        <Width>4in</Width>
        <TableGroups>
          <TableGroup>
            <Grouping Name="CustomerGroup">
              <GroupExpressions>
                <GroupExpression>=Fields!CustomerID.Value</GroupExpression>
              </GroupExpressions>
            </Grouping>
          </TableGroup>
        </TableGroups>
        <TableColumns>
          <TableColumn>
            <Width>1in</Width>
          </TableColumn>
          <TableColumn>
            <Width>1in</Width>
          </TableColumn>
          <TableColumn>
            <Width>1in</Width>
          </TableColumn>
          <TableColumn>
            <Width>1in</Width>
          </TableColumn>
        </TableColumns>
        <Details>
          <TableRows>
            <TableRow>
              <Height>12pt</Height>
              <TableCells>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="CustomerIDCell">
                      <Value>=Fields!CustomerID.Value</Value>
                    </Textbox>
                  </ReportItems>
                </TableCell>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="FreightCell">
                      <Value>=Fields!Freight.Value</Value>
                    </Textbox>
                  </ReportItems>
                </TableCell>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="RunningQuoted">
                      <Value>=RunningValue(Fields!Freight.Value, Sum, "CustomerGroup")</Value>
                    </Textbox>
                  </ReportItems>
                </TableCell>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="RunningUnquoted">
                      <Value>=RunningValue(Fields!Freight.Value, Sum, CustomerGroup)</Value>
                    </Textbox>
                  </ReportItems>
                </TableCell>
              </TableCells>
            </TableRow>
          </TableRows>
        </Details>
      </Table>
    </ReportItems>
  </Body>
  <Width>4in</Width>
  <PageWidth>8.5in</PageWidth>
  <PageHeight>11in</PageHeight>
</Report>
