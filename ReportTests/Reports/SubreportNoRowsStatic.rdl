<?xml version="1.0" encoding="UTF-8"?>
<Report Name="SubreportNoRowsStatic">
  <Description>Subreport half of the no-rows test with no data region: a heading, and a parameter value inside a Rectangle. Its dataset returns no rows, and it has nothing to repeat over them.</Description>
  <DataSources>
    <DataSource Name="DS1">
      <ConnectionProperties>
        <DataProvider>Microsoft.Data.Sqlite</DataProvider>
        <ConnectString>Data Source=northwindEF.db</ConnectString>
        <IntegratedSecurity>false</IntegratedSecurity>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Rows">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>SELECT CustomerID AS Item FROM Orders WHERE 1 = 0</CommandText>
      </Query>
      <Fields>
        <Field Name="Item">
          <DataField>Item</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="Who">
      <DataType>String</DataType>
      <Prompt>Who</Prompt>
    </ReportParameter>
  </ReportParameters>
  <Body>
    <Height>1in</Height>
    <ReportItems>
      <Textbox Name="StaticHeading">
        <Top>0in</Top>
        <Left>0in</Left>
        <Height>0.25in</Height>
        <Width>3in</Width>
        <Value>="STATIC-SUB"</Value>
      </Textbox>
      <Rectangle Name="ParameterFrame">
        <Top>0.3in</Top>
        <Left>0in</Left>
        <Height>0.3in</Height>
        <Width>3in</Width>
        <ReportItems>
          <Textbox Name="ParameterBox">
            <Top>0in</Top>
            <Left>0in</Left>
            <Height>0.25in</Height>
            <Width>3in</Width>
            <Value>=Parameters!Who.Value</Value>
          </Textbox>
        </ReportItems>
      </Rectangle>
    </ReportItems>
  </Body>
  <Width>6in</Width>
  <PageWidth>8.5in</PageWidth>
  <PageHeight>11in</PageHeight>
</Report>
