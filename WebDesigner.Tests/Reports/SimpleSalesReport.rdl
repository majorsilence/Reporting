<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition">
  <Description>A self-contained demo report (no database/file needed) for exercising the report-viewer web component's parameter panel.</Description>
  <ReportParameters>
    <ReportParameter Name="MinAmount">
      <DataType>Integer</DataType>
      <DefaultValue>
        <Values>
          <Value>0</Value>
        </Values>
      </DefaultValue>
      <Prompt>Minimum sale amount</Prompt>
    </ReportParameter>
  </ReportParameters>
  <PageHeight>11in</PageHeight>
  <PageWidth>8.5in</PageWidth>
  <TopMargin>.5in</TopMargin>
  <LeftMargin>.6in</LeftMargin>
  <RightMargin>.6in</RightMargin>
  <BottomMargin>.5in</BottomMargin>
  <Width>7.3in</Width>

  <DataSources>
    <DataSource Name="DS1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString></ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="Sales">
      <Query>
        <DataSourceName>DS1</DataSourceName>
      </Query>
      <Fields>
        <Field Name="Region"><DataField>Region</DataField><TypeName>String</TypeName></Field>
        <Field Name="Customer"><DataField>Customer</DataField><TypeName>String</TypeName></Field>
        <Field Name="Amount"><DataField>Amount</DataField><TypeName>Int32</TypeName></Field>
      </Fields>
      <Rows>
        <Row><Region>East</Region><Customer>Northwind Traders</Customer><Amount>2532</Amount></Row>
        <Row><Region>East</Region><Customer>Contoso Ltd</Customer><Amount>480</Amount></Row>
        <Row><Region>West</Region><Customer>Fabrikam Inc</Customer><Amount>1875</Amount></Row>
        <Row><Region>West</Region><Customer>Tailwind Traders</Customer><Amount>120</Amount></Row>
        <Row><Region>South</Region><Customer>Adventure Works</Customer><Amount>975</Amount></Row>
      </Rows>
    </DataSet>
  </DataSets>

  <Body>
    <Height>4in</Height>
    <ReportItems>
      <Textbox Name="Title">
        <Top>0in</Top><Left>0in</Left><Width>5in</Width><Height>.28in</Height>
        <Value>Sales (report-viewer demo)</Value>
        <Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#2C3E50</Color></Style>
      </Textbox>
      <Textbox Name="Subtitle">
        <Top>.32in</Top><Left>0in</Left><Width>5in</Width><Height>.2in</Height>
        <Value>=&quot;Showing sales &gt;= &quot; &amp; Parameters!MinAmount.Value</Value>
        <Style><FontSize>9pt</FontSize><Color>Gray</Color></Style>
      </Textbox>

      <Table Name="SalesTable">
        <DataSetName>Sales</DataSetName>
        <NoRows>No sales meet this threshold.</NoRows>
        <Top>.7in</Top>
        <Left>0in</Left>
        <Filters>
          <Filter>
            <FilterExpression>=Fields!Amount.Value</FilterExpression>
            <Operator>GreaterThanOrEqual</Operator>
            <FilterValues>
              <FilterValue><Expression>=Parameters!MinAmount.Value</Expression></FilterValue>
            </FilterValues>
          </Filter>
        </Filters>
        <TableColumns>
          <TableColumn><Width>1.5in</Width></TableColumn>
          <TableColumn><Width>3.8in</Width></TableColumn>
          <TableColumn><Width>2in</Width></TableColumn>
        </TableColumns>
        <Header>
          <TableRows>
            <TableRow>
              <Height>.22in</Height>
              <TableCells>
                <TableCell><ReportItems><Textbox Name="H_Region"><Value>Region</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2C3E50</BackgroundColor><Color>White</Color><PaddingLeft>4pt</PaddingLeft></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="H_Customer"><Value>Customer</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2C3E50</BackgroundColor><Color>White</Color><PaddingLeft>4pt</PaddingLeft></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="H_Amount"><Value>Amount</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2C3E50</BackgroundColor><Color>White</Color><TextAlign>Right</TextAlign><PaddingRight>4pt</PaddingRight></Style></Textbox></ReportItems></TableCell>
              </TableCells>
            </TableRow>
          </TableRows>
          <RepeatOnNewPage>true</RepeatOnNewPage>
        </Header>
        <Details>
          <TableRows>
            <TableRow>
              <Height>.2in</Height>
              <TableCells>
                <TableCell><ReportItems><Textbox Name="D_Region"><Value>=Fields!Region.Value</Value><Style><PaddingLeft>4pt</PaddingLeft><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#F3EEFA", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="D_Customer"><Value>=Fields!Customer.Value</Value><Style><PaddingLeft>4pt</PaddingLeft><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#F3EEFA", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell>
                <TableCell><ReportItems><Textbox Name="D_Amount"><Value>=Format(Fields!Amount.Value, "C0")</Value><Style><TextAlign>Right</TextAlign><PaddingRight>4pt</PaddingRight><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#F3EEFA", "White")</BackgroundColor></Style></Textbox></ReportItems></TableCell>
              </TableCells>
            </TableRow>
          </TableRows>
        </Details>
      </Table>
    </ReportItems>
  </Body>
</Report>
