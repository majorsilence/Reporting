<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net48 dropped: Majorsilence.Forms itself only targets net8.0/net10.0. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- Declared explicitly so it matches the rest of the solution's 4-config set; see
         RdlViewer.Forms/RdlViewer.csproj's identical comment for why this matters. -->
    <Configurations>Debug;Release</Configurations>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <PackageId>Majorsilence.WinformUtils</PackageId>
    <Description>Shared utility controls used by the Majorsilence Reporting viewer and designer, built on Majorsilence.Forms (cross-platform WinForms-API-compatible framework). Targets .NET 8 and .NET 10, any OS Majorsilence.Forms.Avalonia supports.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Update="Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Majorsilence.Forms" />
    <PackageReference Include="Majorsilence.Forms.Avalonia" />
  </ItemGroup>
</Project>